String><String name="Village">Villaggio</String><String name="Water lily">Ninfea</String><String name="Bee">Ape</String><String name="Pickaxe">Piccone</String><String name="T-Rex">T-Rex</String></Localization><?xml version="1.0" encoding="utf-8"?><Localization><String name="ANIMAL_PLANET_TITLE">Pianeta animale</String><String name="INAPP_STARTER_KIT_DESC"/><String name="NO_ADS">No Ads</String><String name="UPDATE_TO_A_NEW_APP">Questa versione non Ã¨ piÃ¹ supportato . Si prega di salvare i tuoi progressi e aggiornamento per la nuova applicazione .</String><String name="MUSIC_QUERY_TEXT">Vuoi continuare ad ascoltare la vostra musica ?</String><String name="MUSIC_QUERY_CAPTION">Musica</String><String name="MUSIC_QUERY_DISABLE_GAMEMUSIC">SÃ¬</String><String name="MUSIC_QUERY_DISABLE_PLAYER">No</String><String name="MESSAGEBOX_YES_SUPER_OFFER">Prendila ORA</String><String name="MESSAGEBOX_NO_SUPER_OFFER">Cancella</String><String name="MESSAGEBOX_NO2_SUPER_OFFER">I need to think</String><String name="MESSAGEBOX_MINP_NAME_1">AZIONE!</String><String name="MESSAGEBOX_MINP_NAME_2">AZIONE!</String><String name="MESSAGEBOX_MINP_INFO_1">Add 1$ and get %s mana! Time is limited!</String><String name="MESSAGEBOX_MINP_INFO_2">Are you sure?</String><String name="MESSAGEBOX_BLITZ_REACTIONS">reazioni</String><String name="MESSAGEBOX_GO_TO_WIKI">Vai al sito di Wikipedia</String><String name="TRY_OTHER">Prova anche altri giochi di JoyBits</String><String name="MESSAGEBOX_RATE_TITLE">Il gioco ti piace?</String><String name="MESSAGEBOX_RATE_NEW">Faccelo sapere! Valuta l'applicazione!</String><String name="MESSAGEBOX_RATE_NEW_LOWRATE">Grazie!</String><String name="TO_THE_BANK_BUTTON">Alla banca</String><String name="CROSS_PROMO_DESC_DD">Abbraccia il tuo Lato Oscuro!</String><String name="CROSS_PROMO_DESC_DK">Ãˆ il momento di MEDIEVALI!</String><String name="CROSS_PROMO_DESC_DC_DF">Creare una creatura straordinaria</String><String name="CROSS_PROMO_DESC_DT_DF">Ãˆ ora di partire per la guerra!</String><String name="UNLOCK_FULL_VERSION_BY_MOBILE">Sblocca la versione completa con mobile</String><String name="MAINMENU_SCR_EXIT_BTN">Esci</String><String name="UNLOCK_QUEST">Vuoi sbloccare questa missione?</String><String name="UNLOCK_PUZZLE">Vuoi sbloccare questo rompicapo?</String><String name="CROSS_PROMO_TEXT_DG">Libera la tua immaginazione e diventa un Dio</String><String name="CROSS_PROMO_TEXT_DD">Combina fuoco, terra, acqua e aria per creare demoni, bestie, zombie... e molto altro ancora!</String><String name="ARTIFACT_NOTIF_MSG">Ãˆ tempo di creare nuovi artefatti in Doodle God.</String><String name="LOCKED">Bloccato</String><String name="CLICK">Clicca</String><String name="INFINITE_MANA">Mana infinito</String><String name="MAINMENU_SCR_CREDITS_BTN">Rin|gra|zi|a|men|ti</String><String name="MAINMENU_SCR_OPTIONS_BTN">Opzioni</String><String name="MAINMENU_SCR_PLAY_BTN">Gioca</String><String name="MAINMENU_SCR_UNIVERSE_BTN">Universo\nDoodle</String><String name="PVP_PLAY">Gioca %s{{img=message_box/energy_card.png}}</String><String name="REACTION_POWER">Bagliore:\n%s</String><String name="REACTION_POWER_NO_TEXT">%d%%</String><String name="REACTION_RESULT_NEW_ELEMENT">Nuovo elemento creato!</String><String name="REACTION_RESULT_NEW_ELEMENT_PLURAL">Nuovi elementi creati!</String><String name="STATUS_BAR_ELEMENTS">Elementi: %s/%s</String><String name="STATUS_BAR_GROUPS">Gruppi: %s/%s</String><String name="STATUS_BAR_REACTIONS">Reazioni: %s/%s</String><String name="STATUS_BAR_SEPARATOR">/</String><String name="STATUS_BAR_PROGRESS">Progresso della missione: %s%%</String><String name="STATUS_BAR_PROGRESS_PUZZLE">Progresso attuale: %s%%</String><String name="OPTIONS_SCR_TITLE">Opzioni</String><String name="OPTIONS_SCR_SOUND">Audio</String><String name="OPTIONS_SCR_VOICE">Voce</String><String name="OPTIONS_SCR_MUSIC">Musica</String><String name="OPTIONS_SCR_KIDS_ON">ModalitÃ  sicura (bambini) ATTIVATA</String><String name="OPTIONS_SCR_KIDS_OFF">ModalitÃ  sicura (bambini) DISATTIVATA</String><String name="OPTIONS_SCR_NOTIFICATIONS">Notifiche</String><String name="OPTIONS_TOOLBAR_LANGUAGE_BTN">IT</String><String name="OPTIONS_SCR_VIBRATION">Vibrazione</String><String name="PLAYMENU_SCR_MAIN_GAME">Gioco\nPrincipale</String><String name="PLAYMENU_SCR_MAIN_GAME_ONE_LINE">Gioco Principale</String><String name="PLAYMENU_SCR_QUESTS">Missioni</String><String name="PLAYMENU_SCR_PUZZLES">Enigmi</String><String name="PLAYMENU_SCR_ARTIFACTS">Artefatti</String><String name="PLAYMENU_SCR_MINI_GAMES">Mini giochi</String><String name="QUESTS_SCR_RUN_SANTA">Corri, Babbo Natale, corri!</String><String name="QUESTS_SCR_RUN_SANTA_DESC">Aiuta Babbo Natale a preparare dei regali.</String><String name="QUESTS_SCR_PRINCESS">Salva la Principessa</String><String name="QUESTS_SCR_PRINCESS_DESC">dal drago, ma certo non gratuitamente.</String><String name="QUESTS_SCR_DEVIL_VS_GOD">Diavolo contro Dio</String><String name="QUESTS_SCR_DEVIL_VS_GOD_DESC">Crea virtÃ¹ per contrastare i peccati.</String><String name="QUESTS_SCR_SURVIVOR">Sopravvissuto</String><String name="QUESTS_SCR_SURVIVOR_DESC">Fuggi dall'isola nel bel mezzo dell'oceano.</String><String name="PUZZLES_SCR_LOCOMOTIVE">Locomotiva</String><String name="PUZZLES_SCR_LOCOMOTIVE_DESC">Crea da semplici elementi</String><String name="PUZZLES_SCR_SKYSCRAPER">Grattacielo</String><String name="PUZZLES_SCR_SKYSCRAPER_DESC">Crea da sabbia e pietra</String><String name="PUZZLES_SCR_CHRISTMAS_DECOR">Decorazioni natalizie</String><String name="PUZZLES_SCR_CHRISTMAS_DECOR_DESC">Decora la casa</String><String name="MINI_GAMES_SCR_BEJOINED">Bejoined</String><String name="MINI_GAMES_SCR_MATCHTRIX">MatchTrix</String><String name="MINI_GAMES_SCR_SCORES">Punteggi:</String><String name="TREE_MAIN_GAME_TITLE">Scegli episodio</String><String name="TREE_MAIN_GAME_TITLE_RESET">Resetta episodio</String><String name="TREE_MAIN_GAME_LABEL_MAGIC">Magia</String><String name="TREE_MAIN_GAME_LABEL_NO_MAGIC">Senza Magia</String><String name="TREE_MAIN_GAME_MAGIC">Mondo della Magia</String><String name="TREE_MAIN_GAME_MAGIC_DESC">200+ elementi</String><String name="TREE_MAIN_GAME_MODERN">EtÃ  moderna</String><String name="TREE_MAIN_GAME_MODERN_DESC">140 elementi</String><String name="TREE_MAIN_GAME_TECHNOLOGY">Tecnologia</String><String name="TREE_MAIN_GAME_TECHNOLOGY_DESC">100 elementi</String><String name="TREE_MAIN_GAME_BASIC">Inizio</String><String name="TREE_MAIN_GAME_BASIC_DESC">4 elementi</String><String name="TREE_MAIN_GAME_CLICKED_COMPLETED_EPISODE">Hai giÃ  completato| questo episodio, vuoi| visualizzarlo?</String><String name="TEASER1_SKIP">(salta)</String><String name="TEASER1_CAPTION">Introduzione:</String><String name="TEASER1_1">In principio c'era\nsolo Doodle God.</String><String name="TEASER1_2">Doodle God creÃ²\ni quattro elementi base...</String><String name="TEASER1_3">Dalla terra Doodle God\ncreÃ² i pianeti...</String><String name="TEASER1_4">Dall'acqua creÃ²\nmari e oceani...</String><String name="TEASER1_5">Dal fuoco furono creati\nvulcani... e altre cose...</String><String name="TEASER1_6">Dall'aria... beh... l'Aria...</String><String name="TEASER1_7">Ma il mondo era ancora\nvasto e deserto...</String><String name="TEASER1_8">...e quindi Doodle God fu\ncolpito da una grande idea!</String><String name="TEASER1_9">'E se combinassi gli elementi base\nper creare dei nuovi elementi?'</String><String name="TEASER1_10">E Doodle God cominciÃ²\na creare nuovi elementi...</String><String name="TEASER1_11">'Wow! Ci sono cosÃ¬ tante cose da\ncombinare, cosÃ¬ tanto da creare!'</String><String name="TEASER2_CAPTION">Episodio Due</String><String name="TEASER2_1">Doodle God si fermÃ² per guardare\n tutto ciÃ² che era stato creato...</String><String name="TEASER2_2">E notÃ² tutto\nl'infinito vuoto che c'era intorno...</String><String name="TEASER2_3">Anche il Vuoto puÃ² essere un\nbuon elemento per la creazione...</String><String name="TEASER2_4">E allo stesso modo\nDoodle God proclamÃ²...</String><String name="TEASER2_5">'Ora lasciatemelo aggiungere alla mia lista'</String><String name="TEASER3_CAPTION">Episodio Tre</String><String name="TEASER3_1">Nel mondo oggi ci sia\nun'incredibile moltitudine di varietÃ </String><String name="TEASER3_2">Ma davvero! Alcune cose\nnon possono proprio coesistere!</String><String name="TEASER3_3">E quindi, che succederebbe se\ni mondi fossero divisi</String><String name="TEASER3_4">E fosse permesso ai loro abitanti\ndi seguire ognuno la propria strada?</String><String name="TEASER3_5">'Sicuramente' -\npensÃ² Doodle God -</String><String name="TEASER3_6">'Avranno bisogno di saggezza,\nconoscenza, e... uhm... tutte quelle cose.'</String><String name="TEASER4_CAPTION">Episodio Quattro</String><String name="TEASER4_1">Doodle God pensÃ² che sarebbe\nstata una magnifica idea...</String><String name="TEASER4_2">...donare il potere della\ncreazione agli uomini.</String><String name="TEASER4_3">PerchÃ© essi siano in grado di cambiare\nil mondo come desiderano.</String><String name="TEASER4_4">'Oops, hanno appena trovato\nuno scheletro nell'armadio'</String><String name="TEASER4_5">Beh, ad ogni modo, vediamo se sono\nabbastanza coraggiosi da occuparsene!</String><String name="TEASER_Q1_CAPTION">Corri, Babbo Natale, corri:</String><String name="TEASER_Q1_1">Babbo Natale s'Ã¨ appena accorto che\nnon vengono preparati abbastanza doni.</String><String name="TEASER_Q1_2">E manca cosÃ¬\npoco tempo.</String><String name="TEASER_Q1_3">Dio mio!</String><String name="TEASER_Q1_4">Dovremmo darci una mossa\ne fare piÃ¹ doni!</String><String name="TEASER_Q2_CAPTION">Salva la Principessa:</String><String name="TEASER_Q2_1">Una grande tragedia s'Ã¨\nabbattuta sul nostro regno!</String><String name="TEASER_Q2_2">Ma fortunatamente abbiamo\nun sacco di eroi per aiutarci!</String><String name="TEASER_Q2_FIN_CAPTION">Congratulazioni!</String><String name="TEASER_Q2_FIN_1">E vissero per sempre\nfelici e contenti...</String><String name="TEASER_Q2_FIN_2">...e poi morirono\nquello stesso giorno.</String><String name="TEASER_Q3_CAPTION">Diavolo contro Dio:</String><String name="TEASER_Q3_1">Doodle Devil ha inventato\nmolte cose cattive!</String><String name="TEASER_Q3_2">In risposta, Doodle God ha\ndeciso di creare le virtÃ¹.</String><String name="TEASER_QLOST_CAPTION">Sopravvissuto:</String><String name="TEASER_QLOST_1">Sull'isola deserta ti sei annoiato e\nhai deciso di cominciare a pensare alla fuga</String><String name="TEASER_QLOST_KNIFE_CAPTION">Coltello</String><String name="TEASER_QLOST_KNIFE_1">Hai appena scoperto il coltello.</String><String name="TEASER_QLOST_MAP_CAPTION">Mappa</String><String name="TEASER_QLOST_MAP_1">Hai appena scoperto la mappa.</String><String name="PINCODE_SCR_ENTER">Inserisci il codice segreto pin:</String><String name="PINCODE_SCR_CREATE">Crea un codice segreto pin:</String><String name="PINCODE_SCR_RETYPE">Scrivi nuovamente il codice segreto pin:</String><String name="LANGUAGE_SCR_TITLE">Lingua</String><String name="HINT_DLG_HINT_1">Mostra elemento</String><String name="HINT_DLG_HINT_2">Mostra gruppi</String><String name="HINT_DLG_HINT_3">Reazione gratuita</String><String name="HINT_DLG_REMAIN">Suggerimenti rimasti: %d</String><String name="HINT_DLG_USE">Usa</String><String name="HINT_NO_ELEMENTS_CANT_DO">Non hai elementi necessari per una reazione. Sblocca un elemento inattivo.</String><String name="HINT1_TITLE">Suggerimento:</String><String name="HINT2_TITLE">Alcuni di questi elementi potrebbero reagire:</String><String name="HINT1_WHATIF">E se creassi %s?</String><String name="HINT1_BUT_HOW">Ma come?</String><String name="TAP_TO_CONTINUE">(tocca per continuare)</String><String name="CREDITS_RATE">Per favore, ricorda che le tue recensioni da 5 stelle ci aiutano a continuare ad aggiornare il gioco!</String><String name="LOG_SRC_TITLE">Storico reazioni</String><String name="ALPHABET_SCR_TITLE">Elementi scoperti, ordinati alfabeticamente</String><String name="HELP_SCR_TITLE">Come giocare</String><String name="HELP_SCR_TEXT1">1) Espandi\ndue gruppi</String><String name="HELP_SCR_TEXT2">2) Combina\nqualsiasi coppia\ndi elementi</String><String name="HELP_SCR_TEXT3">3) VoilÃ !\nHai appena\ncreato un nuovo\nelemento</String><String name="HELP_SCR_TEXT4">4) Crea oltre 100 elementi mentre costruisci il tuo Universo!</String><String name="HELP_SCR_TEXT5">(libera la tua immaginazione)</String><String name="HELP_SCR_TAP">Tocca</String><String name="HELP2_SCR_TITLE">Come giocare (2 di 2)</String><String name="HELP2_SCR_SOLID_FRAME">Pronto a reagire o non hai altri bordi</String><String name="HELP2_SCR_DOTTED_FRAME">Ancora nessuna coppia (prova altri elementi)</String><String name="HELP2_SCR_GRAY_FRAME">Elemento finale (non Ã¨ possibile ottenere nuovi elementi partendo da questo)</String><String name="HELP2_SCR_ORANGE_FRAME">Elemento creato con mana esaurito (nessuna reazinoe con questo elemento finchÃ© il timer Ã¨ in funzione).</String><String name="SHOP_SCR_TITLE">Negozio</String><String name="SHOP_YOU_HAVE">Tu hai:</String><String name="SHOP_SCR_BUY">Compra</String><String name="SHOP_SCR_SELL">Vendi</String><String name="SHOP_WHEEL_TITLE">Ruota della fortuna</String><String name="SHOP_WHEEL_DESC">Ottieni altri bonus</String><String name="SHOP_HINT1_TITLE">Blocco da 10 suggerimenti</String><String name="SHOP_HINT1_DESC">I suggerimenti ti mostrano degli elementi che potrebbero essere creati a partire da quelli esistenti</String><String name="SHOP_HINT1_LONGDESC">Ogni Suggerisci Elemento ti mostra un elemento che potrebbe essere creato usando elementi giÃ  in tuo possesso. Ma non ti mostrerÃ  come crearlo.</String><String name="SHOP_HINT1_BUY">Confermi di voler acquistare un Blocco da 10 Suggerisci Elemento per</String><String name="SHOP_HINT2_TITLE">Blocco da 10 suggerimenti</String><String name="SHOP_HINT2_DESC">I suggerimenti mostrano due gruppi in cui due elementi potrebbero reagire</String><String name="SHOP_HINT2_LONGDESC">Ogni Suggerisci Gruppo ti mostra due gruppi con elementi che possono reagire.</String><String name="SHOP_HINT2_BUY">Confermi di voler acquistare un Blocco da 10 Suggerisci Gruppo per</String><String name="SHOP_HINT3_TITLE">Blocco da 10 suggerimenti</String><String name="SHOP_HINT3_DESC">I suggerimenti compiono automaticamente una reazione casuale per te</String><String name="SHOP_HINT3_BUY">Confermi di voler acquistare un Blocco da 10 Suggerisci Reazione Gratuita per</String><String name="SHOP_DOTTED_TITLE">Elementi senza coppie</String><String name="SHOP_DOTTED_DESC">Elementi senza coppie avranno un bordo puntato per 24 ore</String><String name="SHOP_DOTTED_DESC_2">Elementi senza coppie avranno un bordo puntato per %s ore</String><String name="SHOP_DOTTED_LONGDESC">Se acquistato, tutti gli elementi che al momento non hanno coppie (e quindi non possono reagire) avranno un bordo puntato.</String><String name="SHOP_DOTTED_BUY">Confermi di voler acquistare Bordo Puntato per</String><String name="SHOP_DOTTED_SELL">Confermi di voler vendere Bordo Puntato per</String><String name="SHOP_GRAY_TITLE">Mostra gli elementi finali</String><String name="SHOP_GRAY_DESC">Il bordo blu indica per 24 ore elementi che sono definitivi per questo episodio</String><String name="SHOP_GRAY_DESC_2">Il bordo blu indica per %s ore elementi che sono definitivi per questo episodio</String><String name="SHOP_GRAY_LONGDESC">Se acquistato, tutti gli elementi che in questo episodio non sono parte di una coppia avranno un bordo blu.</String><String name="SHOP_GRAY_BUY">Confermi di voler acquistare il bordo blu per</String><String name="SHOP_GRAY_SELL">Confermi di voler vendere il bordo blu per</String><String name="SHOP_NO_REPEAT_TITLE">Disattiva ripetizioni</String><String name="SHOP_NO_REPEAT_DESC">Disattiva reazioni che sono giÃ  state scoperte</String><String name="SHOP_NO_REPEAT_LONGDESC">Acquistando questo oggetto Dio non ti permetterÃ  di compiere reazioni che hai giÃ  scoperto.</String><String name="SHOP_NO_REPEAT_LONGDESC_F2P">Acquistando questo oggetto Dio non ti permetterÃ  di compiere reazioni che hai giÃ  scoperto. Questo ti permette di salvare Bagliore e i tuoi nervi.</String><String name="SHOP_NO_REPEAT_BUY">Confermi di voler acquistare Disattiva Ripetizioni per</String><String name="SHOP_NO_REPEAT_SELL">Confermi di voler vendere Disattiva Ripetizioni per</String><String name="SHOP_LIGHT1_TITLE">Bagliore Divino</String><String name="SHOP_LIGHT1_BUY">Confermi di voler acquistare Bagliore Divino</String><String name="SHOP_LIGHT1_DESC">Bagliore Divino Ã¨ sufficiente per %s elementi</String><String name="SHOP_LIGHT1_LONGDESC">Bagliore Divino Ã¨ fondamentale per le reazioni tra elementi. Ogni reazione consuma un po' di Bagliore. Il Bagliore si ricarica col tempo (ore).</String><String name="SHOP_LIGHT2_TITLE">Bagliore Perfetto</String><String name="SHOP_LIGHT2_BUY">Confermi di voler acquistare Bagliore Perfetto</String><String name="SHOP_LIGHT2_DESC">Bagliore Perfetto Ã¨ sufficiente per %s elementi</String><String name="SHOP_LIGHT2_LONGDESC">Bagliore Perfetto Ã¨ piÃ¹ potente, puÃ² sostenere piÃ¹ reazioni di Bagliore Divino.</String><String name="SHOP_ALREADY_BOUGHT">Hai giÃ  acquistato questo oggetto!</String><String name="SHOP_NO_MANA">Mana insufficiente</String><String name="SHOP_PAY_BY_SMS">Pagare con sms</String><String name="PINCODE_WRONG_CODE">Codice pin errato.\nPer favore ritenta.</String><String name="DISMISS">Ok</String><String name="MESSAGEBOX_MORE">Ancora</String><String name="MESSAGEBOX_CANCEL">Cancella</String><String name="MESSAGEBOX_RESET_CONFIRM">Tutti i progressi in questo episodio saranno cancellati e l'episodio ricomincerÃ  dall'inizio. Sei sicuro?</String><String name="MESSAGEBOX_RESET_CONFIRM_QUEST">Tutti i progressi di questa missione saranno cancellati, e la missione ricomincerÃ  dall'inizio. Sei sicuro?</String><String name="MESSAGEBOX_YES">SÃ¬</String><String name="MESSAGEBOX_NO">No</String><String name="MESSAGEBOX_GHOST_ELEMENT_BUY">Rende l'elemento "%s" attivo per</String><String name="QUEST1_PROGRESS_OBJECTIVES">Obiettivi: Prepara regali per tutti!\nNota: Alcuni potrebbero volere piÃ¹ di un regalo.</String><String name="QUEST1_COMPLETE">Congratulazioni!\nTutti i regali sono stati consegnati!</String><String name="QUEST2_PROGRESS_OBJECTIVES">Obiettivi: Uccidi il drago, salva la principessa, ottieni una ricompensa.\n\nNota: fa' attenzione alle trappole.</String><String name="QUEST2_COMPLETE">Congratulazioni!\nLa Principessa Ã¨ salva!</String><String name="QUEST3_PROGRESS_OBJECTIVES">Obiettivi: crea almeno\ntre virtÃ¹ come contromisura ad ogni peccato.</String><String name="QUEST3_COMPLETE">Congratulazioni!\n\nOra il male Ã¨ sconfitto!</String><String name="QUESTLOST_PROGRESS_OBJECTIVES">Obiettivi: Crea qualcosa per\nfuggire dall'isola.</String><String name="QUESTLOST_COMPLETE_SUCCESS_TITLE">Congratulazioni! Sei finalmente riuscito a fuggire!</String><String name="QUESTLOST_COMPLETE_KILLED_TITLE">Sei stato ucciso dai pirati!</String><String name="QUESTLOST_COMPLETE_TORTURE_TITLE">I pirati hanno rubato il tuo tesoro e ti hanno riportato sull'isola.</String><String name="QUESTLOST_COMPLETE_KILLED">Sei stato ucciso dai pirati! Tutto il tuo duro lavoro per cercare di fuggire dall'isola Ã¨ stato inutile!</String><String name="QUESTLOST_COMPLETE_SUCCESS">Congratulazioni! Sei scappato dall'isola deserta con il tesoro e sei ritornato, ricco, sul continente! Tutto il tuo duro lavoro e i tuoi sacrifici non sono stati in vano!</String><String name="QUESTLOST_COMPLETE_TORTURE">I pirati hanno rubato il tuo tesoro e ti hanno riportato sull'isola. Sembra che dovrai passarci il resto dei tuoi giorni.</String><String name="GO_MOBILE_BTN">Go\nMobile</String><String name="RESET_CONFIRM">Il tuo progresso sarÃ  perduto. Sei sicuro di voler resettare?</String><String name="REVIEW_PROMPT">Se Doodle God ti piace\nper favore dagli 5 stelle.</String><String name="TEASER_SKIP_BTN">Salta</String><String name="SNAPPED_PROMPT">Gioca a Doodle God in modalitÃ  schermo intero</String><String name="PORTRAIT_PROMPT">Gioca a Doodle God in modalitÃ  schermo orizzontale</String><String name="EPISODE_FINISHED_SIGN">Ok</String><String name="EPISODE_FINISHED_DIALOG_PROMPT">Hai completato questo episodio!</String><String name="SHARE_TITLE">Doodle God</String><String name="SHARE_DEFAULT_DESC"/><String name="SHARE_BODY_FOOTER_LINK">&lt;br&gt;&lt;br&gt;&lt;link href="www.doodlegod.com"&gt;www.doodlegod.com&lt;/link&gt;</String><String name="SHARE_DEFAULT_BODY">Sto giocando Doodle God su Windows 8!!!&lt;br&gt;&lt;br&gt;&lt;link href="www.doodlegod.com"&gt;www.doodlegod.com&lt;/link&gt;</String><String name="SHARE_NEW_REACTION_BODY">Ho scoperto una nuova reazione:&lt;b&gt;&lt;br&gt;%s&lt;/b&gt;</String><String name="SHARE_NEW_REACTION_DESC">Nuovo elemento creato</String><String name="SHARE_EPISODE_FINISHED_BODY">Ho completato &lt;b&gt;"%s";&lt;/b&gt;</String><String name="SHARE_EPISODE_FINISHED_DESC"/><String name="IN_APP_ERROR">Scusa... Ora non posso farlo\nRiprova piÃ¹ tardi</String><String name="UNLOCK_THANKS">Grazie</String><String name="DAY_THANKS">Grazie!</String><String name="NO_MORE_HINTS_DAILY">Domani cerca di ottenere nuovi suggerimenti aggiuntivi</String><String name="GAME_OVER_TEXT">Congratulazioni!\nHai completato\nil gioco</String><String name="UPDATE_AVAILABLE">Nuovo aggiornamento\ndisponibile</String><String name="UPDATE_COMING_SOON">Nuovi aggiornamenti\npresto disponibili!</String><String name="RATE_AND_REVIEW">Vota e recensisci</String><String name="REVIEW_PROMPT_2">Non dimenticare di votare e recensire con 5 stelle se vuoi che continuino ad esserci nuovi aggiornamenti.</String><String name="UNLOCK_BTN_GET_FULL">Acquista il\ngioco completo</String><String name="UPDATE_BTN">Aggiorna\nora</String><String name="TILE_main_game_1">Episodio I: Il Principio</String><String name="TILE_main_game_2">Episodio II: Tecnologia</String><String name="TILE_main_game_3">Episodio III: EtÃ  moderna</Strin