<InAppWidget2 name="offerwall" wide="1" width="288" height="136">
    <RewardNoadsBankItemController>
        <Button name="btn_outer" xml="/newbank/big_frame_button.xml" image="/newbank/reskin2/Slot_Bank_Big.png" x="0" y="0" width="288" height="136" >
            <SkeletonWidget name="skeleton" x="144" y="68" width="0" height="0" visible="1" base_scale="4" data="/newbank/reskin2/ADS_MiddleBanner_RW.json" atlas="/newbank/reskin2/BankBanners.atlas.txt" path="resolution"
                event="noads_rw_play">
                <Scenario>
                    [
                        {
                            "id": "play",
                            "ani": "idle",
                            "loop": true
                        }
                    ]
                </Scenario>
                <ControlledWidget bone="time_holder" widget="noads_time" />
                <Text name="noads_time" x="0" y="0" width="30" height="20" font="baloo_bold_medium" autoFit="1" rotation="15" color="FFFFFFFF" align="C" text="12h"/>
            </SkeletonWidget>
            <aImage name="icon" image="/newbank/reskin2/TempNoADS.png" x="-20" y="-15" width="140" height="156"/>
            <Image image="/newbank/reskin2/point.png" x="138" y="33" width="4" height="4" color="FFFFFFFF"/>
            <Image image="/newbank/reskin2/point.png" x="138" y="73" width="4" height="4" color="FFFFFFFF"/>
            <LabelFitController>
                <Text name="description1" text="NOADS_RW_DESC_1" x="147" y="15" width="124" height="40" font="baloo_bold_medium" color="FFFFFFFF" autoFit="1" align="W" _scale="0.8" center_x="0" center_y="20" lineHeight="15" />
                <Text name="description2" text="NOADS_RW_DESC_2" x="147" y="55" width="124" height="40" font="baloo_bold_medium" color="FFFFFFFF" autoFit="1" align="W" _scale="0.8" center_x="0" center_y="20" lineHeight="15"/>
            </LabelFitController>
            <Button name="btn_inner" xml="/newbank/small_frame_button.xml" _image="/newbank/reskin/Btn_Banner.png" x="127" y="100" width="120" height="28">
                <ImageScale9 name="btn" x="0" y="0" width="120" height="28" image="/newbank/reskin/Btn_Banner.png" t9_corners="10,10,10,10" image_extra_scale="2"/>
                <Image image="/newbank/reward_sign.png" x="3" y="2" width="25" height="25"/>
                <Text name="green_btn" text="BANK_FREE" x="25" y="0" width="60" height="28" font="baloo_bold_medium" color="FFFFFFFF" align="C" autoFit="1" _scale="1.2" _dxShadow="0" _dyShadow="1" _colorShadow="FF320C04" case="U"/>
                <Text name="progress" text="%d/%d" x="75" y="0" width="35" height="28" font="baloo_bold_medium" color="FF320C04" autoFit="1" align="E" _scale="1.1" _center_x="0" _center_y="0" lineHeight="15"/>
            </Button>
        </Button>
        <Widget name="activated" _xml="/newbank/big_frame_button.xml" _image="/newbank/reskin2/Slot_Bank_Big.png" x="0" y="0" width="288" height="136" visible="0" >
            <Button x="0" y="0" width="288" height="136" taptic="-1"/>
            <SkeletonWidget name="skeleton" x="144" y="68" width="0" height="0" visible="1" base_scale="4" data="/newbank/reskin2/ADS_MiddleBanner_RW.json" atlas="/newbank/reskin2/BankBanners.atlas.txt" path="resolution" event="noads_rw_play" >
                <Scenario>
                    [
                        {
                            "id": "play",
                            "ani": "idle",
                            "loop": true
                        }
                    ]
                </Scenario>
                <ControlledWidget bone="time_holder" widget="noads_time2" />
                <Text name="noads_time2" x="0" y="0" width="30" height="20" font="baloo_bold_medium" autoFit="1" rotation="15" color="FFFFFFFF" align="C" text="12h"/>
            </SkeletonWidget>
            <Image image="/newbank/reskin2/point.png" x="130" y="25" width="4" height="4" color="FFFFFFFF"/>
            <Text name="description3" text="NOADS_RW_DESC_3" x="139" y="20" width="150" height="55" font="baloo_bold_medium" color="FFFFFFFF" autoFit="1" align="NW" scale="0.9" center_x="0" center_y="0" lineHeight="15" />
            <Widget name="timer_bar" x="140" y="100" width="90" height="25">
                <Image name="back_watch" image="/newbank/reskin2/UnderTimer.png" x="0" y="0" width="90" height="25" />
                <Image name="sandclock" image="/newbank/reskin2/SandClock4.png" x="-15" y="-30" width="32" height="59" rotation="-15" />
                <Text name="time" y="2" text="24h 50m" x="20" width="70" height="20" font="baloo_bold_medium" color="FF300C04" align="C" scale="0.8" />
            </Widget>
            <AnimController autoPlay="1" events="start_spine_anim">
                <ActionRepeat>
                    <ActionChain>
                        <EfxSendEvent event="noads_rw_play" >
                            [
                            {
                            "id": "play",
                            "ani": "main",
                            "loop": false
                            }
                            {
                            "id": "add",
                            "ani": "idle",
                            "loop": true
                            }
                            ]
                        </EfxSendEvent>
                        <EfxWait duration="10"/>
                    </ActionChain>
                </ActionRepeat>
            </AnimController>
        </Button>
    </RewardNoadsBankItemController>
</InAppWidget2>
