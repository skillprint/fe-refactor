e="disableLabel" x="10" y="-2" width="60" height="30" font="font" text="Disable elements" align="C" color="FFFFFFFF"/><aButton name="disable_on" x="70" y="0" image="/interface/check_on.png"><aClick cmd="disable_elements_off" handler="cur_layout"/><Event id="disable_elements_off"/></aButton><aButton name="disable_off" x="70" y="0" image="/interface/check_off.png"><aClick cmd="disable_elements_on" handler="cur_layout"/><Event id="disable_elements_on"/></aButton></Widget><Widget name="disable_m" x="100" y="0" width="130" height="40" scale="0.7"><Button name="next_disable_mode" x="0" y="0" width="60" height="30" image="/message_box/button_01.png"><Text name="disable_mode" x="0" y="-2" width="60" height="30" font="font" text="Mode R" align="C" color="FFFFFFFF"/><Event id="next_disable_mode"/></Button></Widget></aScrollTestControl><HomeButtonController/></Widget></PaneController><aWidget name="cbkg" x="120" y="40" width="64" height="20"><Image image="/message_box/white.png" x="0" y="0" width="64" height="20" color="80000000"/><CounterLabel name="counter_test" x="0" y="0" width="64" height="20" numbers="6" imgs_path="/interface/counter_numbers" color="FFFFFFFF" align="C" clip="1" scale="0.48"/><AnimController autoPlay="1"><ActionRepeat><ActionChain><EfxScaleXY from_x="1" from_y="1" to_x="1.2" to_y="1.2" duration="1"/><EfxScaleXY from_x="1.2" from_y="1.2" to_x="0.8" to_y="0.8" duration="2"/><EfxScaleXY from_x="0.8" from_y="0.8" to_x="1" to_y="1" duration="1"/></ActionChain></ActionRepeat></AnimController></aWidget><AnimController autoPlay="0" events="use_hint_2"><ActionGroup><EfxSendEvent event="sb_change_pane" param="hint2"/></ActionGroup></AnimController><AnimController autoPlay="1"><ActionGroup><EfxSendEvent event="sb_change_pane" param="main"/></ActionGroup></AnimController><EventSwitchWidget event="e_group_hint2_controller"><Case id="e_user_interaction" group="hide"/><Group id="hide"><Event id="sb_change_pane">{"page":"main",}</Event><Event id="e_group_hint2_controller