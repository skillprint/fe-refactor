"Rainbow">Rainbow</String><String name="Rust">Rust</String><String name="Waterfall">Waterfall</String><String name="Volcano">Volcano</String><String name="Cloud">Cloud</String><String name="Jellyfish">Jellyfish</String><String name="Pyramid">Pyramid</String><String name="Rockshaper">Rockshaper</String><String name="Shark">Shark</String><String name="Torch">Torch</String><String name="Yeti">Yeti</String><String name="Aquarium">Aquarium</String><String name="Atlantis">Atlantis</String><String name="Avalanche">Avalanche</String><String name="Candle">Candle</String><String name="Castle wall">Castle wall</String><String name="Catacombs">Catacombs</String><String name="Catapult">Catapult</String><String name="Chariot">Chariot</String><String name="Drowned">Drowned</String><String name="Fire elemental">Fire elemental</String><String name="Flatlands">Flatlands</String><String name="Forge">Forge</String><String name="Gem">Gem</String><String name="Grave">Grave</String><String name="Graveyard">Graveyard</String><String name="Iceberg">Iceberg</String><String name="Innkeeper">Innkeeper</String><String name="Knight">Knight</String><String name="Lake">Lake</String><String name="Lumber">Lumber</String><String name="Mermaid">Mermaid</String><String name="Militia">Militia</String><String name="Mill">Mill</String><String name="Mine">Mine</String><String name="Necklace">Necklace</String><String name="Noble">Noble</String><String name="Omelet">Omelet</String><String name="Ore">Ore</String><String name="Parchment">Parchment</String><String name="Peasant">Peasant</String><String name="Plow">Plow</String><String name="Plowman">Plowman</String><String name="Power">Power</String><String name="Ram">Ram</String><String name="Ranger">Ranger</String><String name="Ruins">Ruins</String><String name="Rusty weapon">Rusty weapon</String><String name="Siege tower">Siege tower</String><String name="Smith">Smith</String><String name="Soup">Soup</String><String name="Stone circle">Stone circle</String><String name="Village">Village</String><String name="Water lily">Water lily</String><String name="Bee">Bee</String><String name="Pickaxe">Pickaxe</String><String name="T-Rex">T-Rex</String></Localization><?xml version="1.0" encoding="utf-8"?><Localization><String name="ANIMAL_PLANET_TITLE">Animal planet</String><String name="DS_WINDOW_TITLE">Digital Star Promotion</String><String name="DS_DAILY_MANA_BONUS">5 mana every day</String><String name="DS_DAILY_RANDOM_HINT_BONUS">1 random hint every day</String><String name="DS_DAILY_GLOW_RECHARGE">Restore Divine Glow every day</String><String name="DS_INAPP_MANA_HINTS">Â +1000 Mana when buying 3000</String><String name="DS_WINDOW_BUTTON">Download free card</String><String name="INAPP_STARTER_KIT_DESC"/><String name="NO_ADS">No Ads</String><String name="UPDATE_TO_A_NEW_APP">This version is no longer supported. Please save your progress and update to the new app.</String><String name="MUSIC_QUERY_TEXT">Do you want to keep listening to your music?</String><String name="MUSIC_QUERY_CAPTION">Music</String><String name="MUSIC_QUERY_DISABLE_GAMEMUSIC">Yes</String><String name="MUSIC_QUERY_DISABLE_PLAYER">No</String><String name="MESSAGEBOX_YES_SUPER_OFFER">Get it NOW</String><String name="MESSAGEBOX_NO_SUPER_OFFER">Cancel</String><String name="MESSAGEBOX_NO2_SUPER_OFFER">I need to think</String><String name="MESSAGEBOX_MINP_NAME_1">SALE!</String><String name="MESSAGEBOX_MINP_NAME_2">SALE!</String><String name="MESSAGEBOX_MINP_INFO_1">Add 1$ and get %s mana! Time is limited!</String><String name="MESSAGEBOX_MINP_INFO_2">Are you sure?</String><String name="MESSAGEBOX_BLITZ_REACTIONS">reactions</String><String name="TRY_OTHER">Try other games from JoyBits</String><String name="MESSAGEBOX_GO_TO_WIKI">Go to Wikipedia site</String><String name="MESSAGEBOX_RATE_TITLE">Rate our game</String><String name="MESSAGEBOX_RATE_NEW">If you love Doodle God please leave us a great rating!</String><String name="MESSAGEBOX_RATE_NEW_LOWRATE">Thank you for your review!</String><String name="TO_THE_BANK_BUTTON">To the bank</String><String name="CROSS_PROMO_DESC_DD">Embrace Your Dark Side</String><String name="CROSS_PROMO_DESC_DK">It's time to get MEDIEVAL!</String><String name="CROSS_PROMO_DESC_DC_DF">Create an Amazing Creature</String><String name="CROSS_PROMO_DESC_DT_DF">Itâ€™s Time to Go to War!</String><String name="UNLOCK_FULL_VERSION_BY_MOBILE">Unlock full version by mobile</String><String name="MAINMENU_SCR_EXIT_BTN">Exit</String><String name="UNLOCK_QUEST">Do you want to unlock this quest?</String><String name="UNLOCK_PUZZLE">Do you want to unlock this puzzle?</String><String name="CROSS_PROMO_TEXT_DG">Unleash your imagination and be a God</String><String name="CROSS_PROMO_TEXT_DD">Combine fire, earth, wind and air to create demons, beasts, zombies... and much more.</String><String name="SHOP_FREE_RECHARGE">You have run out of Divine Glow. You can't unlock elements without it! But, since it's the first time, we'll recharge it for you for free!</String><String name="TUT_GLOW_END_SECOND_GAME">You're out of Divine Glow! Let's recharge it!</String><String name="TUT_GLOW_END_SECOND_SHOP">Use mana to recharge!</String><String name="TUT_GLOW_END_THIRD_MSG">You've run out of Divine Glow. It will be recharged in\n%s\nYou can still complete quests, since they don't require Divine Glow!</String><String name="ARTIFACT_NOTIF_MSG">Time to create new artifacts in Doodle God.</String><String name="LOCKED">Locked</String><String name="CLICK">Click</String><String name="INFINITE_MANA">Infinite mana</String><String name="MAINMENU_SCR_CREDITS_BTN">Credits</String><String name="MAINMENU_SCR_OPTIONS_BTN">Options</String><String name="MAINMENU_SCR_PLAY_BTN">Play</String><String name="MAINMENU_SCR_UNIVERSE_BTN">Doodle\nUniverse</String><String name="PVP_PLAY">Play %s{{img=message_box/energy_card.png}}</String><String name="REACTION_POWER">Glow power:\n%s elements</String><String name="REACTION_POWER_NO_TEXT">%d%%</String><String name="REACTION_RESULT_NEW_ELEMENT">New element created!</String><String name="REACTION_RESULT_NEW_ELEMENT_PLURAL">New elements created!</String><String name="STATUS_BAR_ELEMENTS">Elements: %s/%s</String><String name="STATUS_BAR_ELEMENTS_TITLE">Elements:</String><String name="STATUS_BAR_ELEMENTS_VALUE">%s/%s</String><String name="STATUS_BAR_GROUPS">Groups: %s/%s</String><String name="STATUS_BAR_REACTIONS">Reactions: %s/%s</String><String name="STATUS_BAR_REACTIONS_TITLE">Reactions:</String><String name="STATUS_BAR_REACTIONS_VALUE">%s/%s</String><String name="STATUS_BAR_REACTIONS_CURRENT">Reactions: </String><String name="STATUS_BAR_SEPARATOR">/</String><String name="STATUS_BAR_PROGRESS">Quest Progress: %s%%</String><String name="STATUS_BAR_PROGRESS_PUZZLE">Puzzle Progress: %s%%</String><String name="STATUS_BAR_ACTION_TEXT">Action time left</String><String name="OPTIONS_SCR_TITLE">Options</String><String name="OPTIONS_SCR_SOUND">Sound</String><String name="OPTIONS_SCR_VOICE">Voice</String><String name="OPTIONS_SCR_MUSIC">Music</String><String name="OPTIONS_SCR_KIDS_ON">Kids safe mode ON</String><String name="OPTIONS_SCR_KIDS_OFF">Kids safe mode OFF</String><String name="OPTIONS_SCR_NOTIFICATIONS">Notifications</String><String name="OPTIONS_TOOLBAR_LANGUAGE_BTN">EN</String><String name="OPTIONS_DISABLE_ADS">Disable partner ads</String><String name="OPTIONS_SCR_VIBRATION">Vibration</String><String name="PLAYMENU_SCR_MAIN_GAME">Main\nGame</String><String name="PLAYMENU_SCR_MAIN_GAME_ONE_LINE">Main Game</String><String name="PLAYMENU_SCR_QUESTS">Quests</String><String name="PLAYMENU_SCR_PUZZLES">Puzzles</String><String name="PLAYMENU_SCR_ARTIFACTS">Artifacts</String><String name="PLAYMENU_SCR_MINI_GAMES">Mini Games</String><String name="QUESTS_SCR_RUN_SANTA">Go Santa Go!</String><String name="QUESTS_SCR_RUN_SANTA_DESC">Help Santa deliver his presents!</String><String name="QUESTS_SCR_PRINCESS">Save the Princess</String><String name="QUESTS_SCR_PRINCESS_DESC">from the Dragon, not for free of course.</String><String name="QUESTS_SCR_DEVIL_VS_GOD">Devil vs. God</String><String name="QUESTS_SCR_DEVIL_VS_GOD_DESC">Create virtues as countermeasure to sins.</String><String name="QUESTS_SCR_SURVIVOR">Survivor</String><String name="QUESTS_SCR_SURVIVOR_DESC">Escape from the island in the middle of the ocean.</String><String name="MINI_GAMES_SCR_BEJOINED">Bejoined</String><String name="MINI_GAMES_SCR_MATCHTRIX">MatchTrix</String><String name="MINI_GAMES_SCR_SCORES">Scores:</String><String name="TREE_MAIN_GAME_TITLE">Select Episode</String><String name="TREE_MAIN_GAME_TITLE_RESET">Reset Episode</String><String name="TREE_MAIN_GAME_LABEL_MAGIC">Magic</String><String name="TREE_MAIN_GAME_LABEL_NO_MAGIC">No Magic</String><String name="TREE_MAIN_GAME_MAGIC">World of Magic</String><String name="TREE_MAIN_GAME_MAGIC_DESC">200+ elements</String><String name="TREE_MAIN_GAME_MODERN">Modern Age</String><String name="TREE_MAIN_GAME_MODERN_DESC">140 elements</String><String name="TREE_MAIN_GAME_TECHNOLOGY">Technology</String><String name="TREE_MAIN_GAME_TECHNOLOGY_DESC">100 elements</String><String name="TREE_MAIN_GAME_BASIC">Beginning</String><String name="TREE_MAIN_GAME_BASIC_DESC">4 elements</String><String name="TREE_MAIN_GAME_CLICKED_COMPLETED_EPISODE">You've already completed this episode, do you want to view it?</String><String name="TEASER1_SKIP">(skip)</String><String name="TEASER1_CAPTION">Intro:</String><String name="TEASER1_1">In the beginning there\nwas only Doodle God.</String><String name="TEASER1_2">Doodle God created\nthe four basic elements...</String><String name="TEASER1_3">From Earth Doodle God\ncreated the planets...</String><String name="TEASER1_4">From Water seas and\noceans were created...</String><String name="TEASER1_5">From Fire were created\nvolcanoes... and other stuff...</String><String name="TEASER1_6">From Air... you know... Air...</String><String name="TEASER1_7">But the world was still\nvast and deserted...</String><String name="TEASER1_8">...and then Doodle God was\nstruck with a bright idea!</String><String name="TEASER1_9">'What if I combined the basic\nelements to create new ones?'</String><String name="TEASER1_10">And Doodle God began\ncreating new elements...</String><String name="TEASER1_11">'Wow! There is so much to\ncombine, so much to create!'</String><String name="TEASER2_CAPTION">Episode Two</String><String name="TEASER2_1">Doodle God stepped back to\nreview all that was created...</String><String name="TEASER2_2">And he noticed the\ninfinite void all around...</String><String name="TEASER2_3">The Void can also be a\ngood element for creation...</String><String name="TEASER2_4">And likewise\nDoodle God proclaimedeth...</String><String name="TEASER2_5">'Let me add it to my list now'</String><String name="TEASER3_CAPTION">Episode Three</String><String name="TEASER3_1">There be-eth in the world today\nsuch a multitude of variety</String><String name="TEASER3_2">But forsooth! Some things\nsimply can not coexist!</String><String name="TEASER3_3">And so, what if the\nworlds were parted</String><String name="TEASER3_4">And their inhabitants allowed\nto follow a path of their own?</String><String name="TEASER3_5">'To be sure' -\nreasoned Doodle God -</String><String name="TEASER3_6">'They'll be needing wisdom,\nknowledge, and... uh... all that stuff.'</String><String name="TEASER4_CAPTION">Episode Four</String><String name="TEASER4_1">Doodle God thoughteth it would\nbe a most splendid idea...</String><String name="TEASER4_2">...to give the power\nof creation to humans.</String><String name="TEASER4_3">For they will be able to change\nthe world as they desire.</String><String name="TEASER4_4">'Oops, they just found a\nskeleton in a cupboard'</String><String name="TEASER4_5">Well, anyway, lets see if\nthey are brave enough to handle it!</String><String name="TEASER_Q1_CAPTION">Run, Santa, run:</String><String name="TEASER_Q1_1">Santa just figured that there\naren't enough gifts made.</String><String name="TEASER_Q1_2">And there is so\nlittle time left.</String><String name="TEASER_Q1_3">Oh, my!</String><String name="TEASER_Q1_4">We should hurry up\nand make more gifts!</String><String name="TEASER_Q2_CAPTION">Save the Princess:</String><String name="TEASER_Q2_1">A great tragedy hath\noccured in our kindom!</String><String name="TEASER_Q2_2">But luckily we have\nplenty of heroes to help!</String><String name="TEASER_Q2_FIN_CAPTION">Congratulations!</String><String name="TEASER_Q2_FIN_1">They lived happily\nfor ever after...</String><String name="TEASER_Q2_FIN_2">...and then diedeth\nin the same day.</String><String name="TEASER_Q3_CAPTION">Devil vs. God:</String><String name="TEASER_Q3_1">Doodle Devil invented\nmany bad things!</String><String name="TEASER_Q3_2">Doodle God decided to create\nvirtues as a countermeasure</String><String name="TEASER_QLOST_CAPTION">Survivor:</String><String name="TEASER_QLOST_1">You became bored on the desert island\n and decided to start thinking about escape</String><String name="TEASER_QLOST_KNIFE_CAPTION">Knife</String><String name="TEASER_QLOST_KNIFE_1">You've just discovered knife.</String><String name="TEASER_QLOST_MAP_CAPTION">Map</String><String name="TEASER_QLOST_MAP_1">You've just discovered map.</String><String name="PINCODE_SCR_ENTER">Enter secret pin code:</String><String name="PINCODE_SCR_CREATE">Create secret pin code:</String><String name="PINCODE_SCR_RETYPE">Re-type secret pin code:</String><String name="LANGUAGE_SCR_TITLE">Language</String><String name="HINT_DLG_HINT_1">Show element</String><String name="HINT_DLG_HINT_2">Show groups</String><String name="HINT_DLG_HINT_3">Free reaction</String><String name="HINT_NO_ELEMENTS_CANT_DO">You have no elements for a reaction. Unlock an inactive element.</String><String name="HINT1_TITLE">Hint:</String><String name="HINT2_TITLE">Some of these elements may react:</String><String name="HINT1_WHATIF">What if I create %s?</String><String name="HINT1_BUT_HOW">But how?</String><String name="TAP_TO_CONTINUE">(tap to continue)</String><String name="HINT_RECHARGED">Hint recharged</String><String name="CREDITS_RATE">Please remember that your 5 star reviews help keep the updates coming!</String><String name="LOG_SRC_TITLE">Reactions history</String><String name="ALPHABET_SCR_TITLE">Discovered elements, alphabetically</String><String name="HELP_SCR_TITLE">How to Play</String><String name="HELP_SCR_TEXT1">1) Expand\ntwo groups</String><String name="HELP_SCR_TEXT2">2) Combine\nany two\nelements</String><String name="HELP_SCR_TEXT3">3) Voila!\nYou just created a new element</String><String name="HELP_SCR_TEXT4">4) Create over 100 elements as you build your own Universe!</String><String name="HELP_SCR_TEXT5">(unleash your imagination)</String><String name="HELP_SCR_TAP">Tap </String><String name="HELP2_SCR_TITLE">How to Play (2 of 2)</String><String name="HELP2_SCR_SOLID_FRAME">Ready to react or you don't have other frames</String><String name="HELP2_SCR_DOTTED_FRAME">No pair yet (try other elements)</String><String name="HELP2_SCR_GRAY_FRAME">Final element (no new elements from this one)</String><String name="HELP2_SCR_ORANGE_FRAME">Element created with exhausted Mana (no reaction with this element until timer is on).</String><String name="HELP2_SCR_ORANGE_FRAME_V02">The element was created without the Glow (tap the element to unlock it).</String><String name="SHOP_SCR_TITLE">Shop</String><String name="SHOP_YOU_HAVE">You have:</String><String name="SHOP_SCR_BUY">Buy</String><String name="SHOP_SCR_SELL">Sell</String><String name="SHOP_SCR_RESTORE">Restore</String><String name="SHOP_MSG_CHOOSE_ACTION">Please choose an action</String><String name="SHOP_WHEEL_TITLE">Wheel of fortune</String><String name="SHOP_WHEEL_DESC">Get more bonuses</String><String name="SHOP_HINT1_TITLE">Pack of 10 hints</String><String name="SHOP_HINT1_DESC">Hint shows you elements that could be created from existing ones</String><String name="SHOP_HINT1_LONGDESC">Each Element Hint shows you one element that could be created using ones you already have. It won't show how to create one though.</String><String name="SHOP_HINT1_BUY">Are you sure you want to buy a Pack of 10 Element Hints for</String><String name="SHOP_HINT2_TITLE">Pack of 10 hints</String><String name="SHOP_HINT2_DESC">Hint shows two groups where some elements may react</String><String name="SHOP_HINT2_LONGDESC">Each Groups Hint shows you two groups with definitely reactable elements.</String><String name="SHOP_HINT2_BUY">Are you sure you want to buy a Pack of 10 Groups Hints for</String><String name="SHOP_HINT3_TITLE">Pack of 10 hints</String><String name="SHOP_HINT3_DESC">Hint automatically performs one random reaction for you</String><String name="SHOP_HINT3_BUY">Are you sure you want to buy a Pack of 10 Free Reaction Hints for</String><String name="SHOP_DOTTED_TITLE">Elements without pairs</String><String name="SHOP_DOTTED_DESC">Dotted border for elements that have no pair now for 24 hours</String><String name="SHOP_DOTTED_DESC_2">Dotted border for elements that have no pair now for %s hours</String><String name="SHOP_DOTTED_LONGDESC">If bought, all elements that have no pair at the moment (i.e. cannot react) will have dotted border.</String><String name="SHOP_DOTTED_BUY">Are you sure you want to buy Dotted border for</String><String name="SHOP_DOTTED_SELL">Are you sure you want to sell Dotted border for</String><String name="SHOP_GRAY_TITLE">Show final elements</String><String name="SHOP_GRAY_DESC">Blue border for elements that are final for current episode for 24 hours</String><String name="SHOP_GRAY_DESC_2">Blue border for elements that are final for current episode for %s hours</String><String name="SHOP_GRAY_LONGDESC">If bought, all elements that have no pair at all in current Episode will have a blue border.</String><String name="SHOP_GRAY_BUY">Are you sure you want to buy Blue border for</String><String name="SHOP_GRAY_SELL">Are you sure you want to sell Blue border for</String><String name="SHOP_NO_REPEAT_TITLE">Disable repetition</String><String name="SHOP_NO_REPEAT_DESC">Disables reactions that have already been discovered</String><String name="SHOP_NO_REPEAT_LONGDESC">By purchasing this item God won't allow you to perform reactions that you have already discovered.</String><String name="SHOP_NO_REPEAT_LONGDESC_F2P">By purchasing this item God won't allow you to perform reactions that you have already discovered. This saves more Glow Power and your nerves.</String><String name="SHOP_NO_REPEAT_BUY">Are you sure you want to buy Disable Repetition for</String><String name="SHOP_NO_REPEAT_SELL">Are you sure you want to sell Disable Repetition for</String><String name="SHOP_LIGHT1_TITLE">Divine Glow</String><String name="SHOP_LIGHT1_BUY">Are you sure you want to buy Divine Glow</String><String name="SHOP_LIGHT1_DESC">Divine Glow serves for %s elements</String><String name="SHOP_LIGHT1_LONGDESC">Divine Glow is essential for elements reactions. Every reaction wears Glow out a little. Glow refreshes itself after some time (hours).</String><String name="SHOP_LIGHT2_TITLE">Immaculate Glow</String><String name="SHOP_LIGHT2_BUY">Are you sure you want to buy Immaculate Glow</String><String name="SHOP_LIGHT2_DESC">Immaculate Glow serves for %s elements</String><String name="SHOP_LIGHT2_LONGDESC">Immaculate Glow is more powerful - it can handle more reactions than Divine Glow.</String><String name="SHOP_ALREADY_BOUGHT">You have already bought this item!</String><String name="SHOP_NO_MANA">Not enough mana</String><String name="SHOP_DISCOUNTS_ANNOUNCE_MSG">Sale! Some prices are temporary decreased!</String><String name="SHOP_ACTION_HEADER">SALE!</String><String name="SHOP_ACTION_DESC">Buy energy and receive prizes!</String><String name="SHOP_ACTION_TIME">Time left until the end of sale:</String><String name="SHOP_ACTION_BUY">BUY NOW</String><String name="SHOP_ACTION_NOWONLY">Now Only:</String><String name="SHOP_PAY_BY_SMS">Pay by SMS</String><String name="PINCODE_WRONG_CODE">Incorrect pin code.\nPlease try again.</String><String name="DISMISS">OK</String><String name="MESSAGEBOX_MORE">More</String><String name="MESSAGEBOX_CANCEL">Cancel</String><String name="MESSAGEBOX_RESET_CONFIRM">All progress on this episode will be erased and the episode will be started over. Are you sure?</String><String name="MESSAGEBOX_RESET_CONFIRM_QUEST">All progress on this quest will be erased and the quest will be started over. Are you sure?</String><String name="MESSAGEBOX_YES">Yes</String><String name="MESSAGEBOX_NO">No</String><String name="MESSAGEBOX_GHOST_ELEMENT_BUY">Make element "%s" active for</String><String name="MESSAGEBOX_CONTINUE">Continue</String><String name="MESSAGEBOX_TUTORIAL_HINT_DIALOG_F2P">You can get new hints every day! Or buy them in the shop.</String><String name="MESSAGEBOX_TUTORIAL_HINT_DIALOG_PAID">Hints will regenerate in few minutes! Or you can buy them in shop.</String><String name="QUEST1_PROGRESS_OBJECTIVES">Objectives: Make presents for everyone!\nNote: Some may want more than one present.</String><String name="QUEST1_COMPLETE">Congratulations!\nAll presents have been delivered!</String><String name="QUEST2_PROGRESS_OBJECTIVES">Objectives: Kill the dragon, save the princess, get a reward.\n\nNote: beware of traps.</String><String name="QUEST2_COMPLETE">Congratulations!\nPrincess is saved!</String><String name="QUEST3_PROGRESS_OBJECTIVES">Objectives: create at least\nthree virtues as a countermeasure to each sin.</String><String name="QUEST3_COMPLETE">Congratulations!\n\nNow evil is defeated!</String><String name="QUESTLOST_PROGRESS_OBJECTIVES">Objectives: create something to \nescape from the island.</String><String name="QUESTLOST_COMPLETE_KILLED">You were killed by pirates! All of your hard work to try to escape the island failed!</String><String name="QUESTLOST_COMPLETE_TORTURE">The pirates stole your treasure and threw you back on the island. Chances are you will spend the rest of your days here.</String><String name="QUESTLOST_COMPLETE_SUCCESS">Congratulations! You got off the deserted island with the treasure and returned to the mainland a very rich man! All of your hard work and deprivation were not in vain!</String><String name="QUESTLOST_COMPLETE_SUCCESS_TITLE">Congratulations! You've successfully escaped!</String><String name="QUESTLOST_COMPLETE_KILLED_TITLE">You were killed by pirates!</String><String name="QUESTLOST_COMPLETE_TORTURE_TITLE">The pirates stole your treasure and threw you back on the island.</String><String name="QUEST20TH_PROGRESS_OBJECTIVES">Your Goal: To re-discover the top 10 most significant inventions of each decade of the 20th century.</String><String name="QUEST20TH_COMPLETE">Congratulations!\n\nYou are the greatest inventor of the 20th century!</String><String name="GO_MOBILE_BTN">Go\nMobile</String><String name="RESET_CONFIRM">Your progress will be lost. Are you sure you want to reset?</String><String name="REVIEW_PROMPT">If you like Doodle God\nplease rate it with 5 stars.</String><String name="TEASER_SKIP_BTN">Skip</String><String name="SNAPPED_PROMPT">Go fullscreen to play Doodle God</String><String name="PORTRAIT_PROMPT">Turn to landscape to play Doodle God</String><String name="EPISODE_FINISHED_SIGN">OK</String><String name="EPISODE_FINISHED_DIALOG_PROMPT">You have finished this episode!</String><String name="SHARE_TITLE">Doodle God</String><String name="SHARE_DEFAULT_DESC"/><String name="SHARE_BODY_FOOTER_LINK">&lt;br&gt;&lt;br&gt;&lt;link href="www.doodlegod.com"&gt;www.doodlegod.com&lt;/link&gt;</String><String name="SHARE_DEFAULT_BODY">I'm now playing Doodle God on Windows 8!!!&lt;br&gt;&lt;br&gt;&lt;link href="www.doodlegod.com"&gt;www.doodlegod.com&lt;/link&gt;</String><String name="SHARE_NEW_REACTION_BODY">I've discover new reaction:&lt;b&gt;&lt;br&gt;%s&lt;/b&gt;</String><String name="SHARE_NEW_REACTION_DESC">New element created</String><String name="SHARE_EPISODE_FINISHED_BODY">I have finished &lt;b&gt;"%s";&lt;/b&gt;</String><String name="SHARE_EPISODE_FINISHED_DESC"/><String name="IN_APP_ERROR">Oops... Can't do it right now\nTry again later</String><String name="UNLOCK_THANKS">Thank you</String><String name="DAY_THANKS">Thank you!</String><String name="NO_MORE_HINTS_DAILY">Try to get more extra hints tomorrow</String><String name="GAME_OVER_TEXT">Congratulations!\nYou've passed\nthe game</String><String name="GAME_OVER_TEXT1">Congratulations!</String><String name="GAME_OVER_TEXT2">You've passed\nthe game</String><String name="UPDATE_AVAILABLE">New update\navailable</String><String name="UPDATE_COMING_SOON">New updates\ncoming soon!</String><String name="RATE_AND_REVIEW">Rate and Review</String><String name="REVIEW_PROMPT_2">Don't forget to rate the game with 5-stars and reviews to keep the updates coming.</String><String name="UNLOCK_BTN">Play Full Game</String><String name="UNLOCK_BTN_GET_FULL">Get Full Game</String><String name="UPDATE_BTN">Update\nnow</String><String name="TILE_main_game_1">Episode I: Beginning</String><String name="TILE_main_game_2">Episode II: Technology</String><String name="TILE_main_game_3">Episode III: Modern Age</String><String name="TILE_main_game_4">Episode IV: World of Magic</String><String name="EPISODE2_LOCKED_MESSAGE">You have to pass\n'Episode One: Beginning'</String><String name="EPISODE3_LOCKED_MESSAGE">You have to pass\n'Episode Two: Technology'</String><String name="EPISODE4_LOCKED_MESSAGE">You have to pass\n'Episode Three: Modern Age'</String><String name="HELP_CAPTION">How to Play</String><String name="FINISH_CAPTION">Well Done and Thank You\nfor wise playing!</String><String name="FINISH_TEXT">Seconds ago you successfully created 100 elements and completed the game.\n\nIn the full version of the game you get four episodes, new quests and minigames, tons of brand new reactions and famous quotes.</String><String name="EXTRA_HINTS">Extra hints</String><String name="EXTRA_HINTS_CAPTION">Extra hints:</String><String name="EXTRA_HINTS_YOU_HAVE">Currently you have</String><String name="EXTRA_HINTS_COUNT">500</String><String name="EXTRA_HINTS_EXTRA_HINTS">extra hints</String><String name="EXTRA_HINTS_DESCRIPTION">With extra hints you don't\nneed to wait for recharge</String><String name="EXTRA_HINTS_TIMER">2:47</String><String name="EXTRA_HINTS_RECHARGE_NOW">RECHARGE\nNOW</String><String name="EXTRA_HINTS_GET_MORE">Get more\nExtra Hints</String><String name="TRIAL_SCREEN_PLAYER">Dear\n    Player</String><String name="TRIAL_SCREEN_FINISHED">You have passed free episode</String><String name="TRIAL_SCREEN_PROMPT">Want more? Upgrade to the full version and get full set of premium features:</String><String name="TRIAL_SCREEN_PROMPT_NO_COLON">Want more? Upgrade to the full version and get full set of premium features.</String><String name="TRIAL_SCREEN_UNLOCK_DESC">Unlock all the features\nnow and continue playing</String><String name="TRIAL_SCREEN_RESTORE_DESC">Restore your previous purchases</String><String name="TRIAL_SCREEN_UNLOCK_BTN">Purchase\nNow</String><String name="TRIAL_SCREEN_DOWNLOAD_DESC">Download full version\nfrom the Store</String><String name="TRIAL_SCREEN_DOWNLOAD_BTN">Get Full</String><String name="TRIAL_BTN">Get it NOW</String><String name="MAINMENU_SCR_UNLOCK_FULL_BTN">Unlock full</String><String name="MAINMENU_SCR_REVIEW_BTN">Review</String><String name="MAINMENU_SCR_FEEDBACK_BTN">Support</String><String name="MAINMENU_SCR_FEEDBACK_SUBJECT">Feedback on %s</String><String name="MAINMENU_SCR_FEEDBACK_BODY">\n\nPlease describe your problem above and don't delete ID mentioned below.\n</String><String name="MAINMENU_SCR_UPDATE_NEW_BTN">Updates</String><String name="GAMEOVER_TEXT">In order to continue, you have to get a mandatory update with tons of extra features and content.</String><String name="UPDATE_TXT">Update</String><String name="UNIVERSE_DG_TXT1">- Over 100,000,000 players tried to create their own world in the last few  month!</String><String name="UNIVERSE_DG_TXT2">- Create 300+ advanced items and concepts!</String><String name="UNIVERSE_DG_TXT3">- Unleash your inner god with Doodle God!</String><String name="UNIVERSE_DG_TXT4">Doodle God puts the power of creation in your hands. Mixing and mathing different elements, work your way up, all the way from bacteria and beetles, to clay and ceramics, to tools, weapons and beyond!</String><String name="UNIVERSE_DG_DOWNLOAD_TXT">Download this game on your platform:</String><String name="UNIVERSE_DD_TXT1">- Over 100,000,000 players worldwide!</String><String name="UNIVERSE_DD_TXT2">- Discover your dark side!</String><String name="UNIVERSE_DD_TXT3">- Explore the seven deadly sins and watch the world become destroyed because of your actions!</String><String name="UNIVERSE_DD_TXT4">Discover different combinations of fire, air, water and land to create demons, monsters, zombies, and much more! Play the Devil Slot Machine with Devilish Coins!</String><String name="UNIVERSE_DG_DOWNLOAD_TXT">Download this game on your platform:</String><String name="UNIVERSE_DF_TXT1">- Over 100,000,000 players worldwide!</String><String name="UNIVERSE_DF_TXT2">- Charge your Farm with cute animals!</String><String name="UNIVERSE_DF_TXT3">- Enjoy fantastic world of creatures. Put your cowboy hat on and start creating in your own way.</String><String name="UNIVERSE_DF_TXT4">Do you know how to create a dog or a tiger? Which animals put together can create a new one? Does Cat + Dog = Tiger? Or does Duck + Herring = Penguin? And can a penguin fly? Discover an entire animal kingdom starting with just four creatures!</String><String name="UNIVERSE_DF_DOWNLOAD_TXT">Download this game on your platform:</String><String name="UNIVERSE_IC_TXT1">- Funny hockey matches and exciting tournaments await you!</String><String name="UNIVERSE_IC_TXT2">- Work your way up from an amateur to a pro with your clan!</String><String name="UNIVERSE_IC_TXT3">- Find rare artifacts and make your team the strongest in the world with Icy Clash!</String><String name="UNIVERSE_IC_TXT4">Build stadiums and blacksmiths, and train your players for glorious victories! Don't forget to send your fans to your friends for support!</String><String name="UNIVERSE_IC_DOWNLOAD_TXT">Download this game on your platform:</String><String name="UNIVERSE_DK_TXT1">- Over 100,000,000 players worldwide!</String><String name="UNIVERSE_DK_TXT2">- Build your very own magical world!</String><String name="UNIVERSE_DK_TXT3">- Enjoy three entertaining quests with an engaging storyline!</String><String name="UNIVERSE_DK_TXT4">Help your Hero become a mighty knight and defeat the monsters that will inevitably appear in your world!</String><String name="UNIVERSE_DC_TXT4">In Doodle Creatures you can find out as you create hundreds of fantastic and unique Creatures by combining different animals.</String><String name="PUZ_TARGET_MSG">Your goal is to create "%s"</String><String name="PUZ_WIN_MSG">Congratulations!\nWell done!</String><String name="PUZ_PASSED_MSG">You've already completed this puzzle. Try a different one!</String><String name="PUZ_NO_FREE_SLOT_MSG">There is no space for the future resulting elements.</String><String name="PUZ_NO_ENOUGH_ELE_MSG">You do not have enough elements for the reaction.</String><String name="PUZ_HELP_P1_M1">1) Choose two elements</String><String name="PUZ_HELP_P2_M1">2) The elements which are used in reactions disappear. You can get two or more elements</String><String name="PUZ_HELP_P3_M1">3) You receive new elements for every reaction</String><String name="PUZ_HELP_P4_M1">4) Combine elements and solve the puzzle</String><String name="PUZ_HELP_LP1_T1">1) Open two groups</String><String name="PUZ_HELP_LP1_T2">2) Choose two elements</String><String name="PUZ_HELP_LP1_T4">4) The elements which are used in reactions disappear.</String><String name="PASS_PREV_EPISODE_TO_UNLOCK">You need to complete the previous episode in order to proceed.</String><String name="MESSAGEBOX_LANG_CONFIRM">Are you sure you want to change the language?</String><String name="OPTIONS_AUTO_LANGUAGE">Auto</String><String name="PUZZLES_SCR_LOCOMOTIVE">Locomotive in the woods</String><String name="PUZZLES_SCR_LOCOMOTIVE_DESC">Create a locomotive of the simple things</String><String name="PUZZLES_SCR_SKYSCRAPER">Skyscraper</String><String name="PUZZLES_SCR_SKYSCRAPER_DESC">Build a skyscraper of sand and stone</String><String name="PUZZLES_SCR_ICECREAM">Let's Eat Some Ice Cream!</String><String name="PUZZLES_SCR_ICECREAM_DESC">Can You create an ice cream cone?</String><String name="PUZZLES_SCR_FLOWER">In the name of peace</String><String name="PUZZLES_SCR_FLOWER_DESC">Turn a nuclear bomb into a flower</String><String name="PUZZLES_SCR_CHRISTMAS_DECOR">Christmas decoration</String><String name="PUZZLES_SCR_CHRISTMAS_DECOR_DESC">Decorate your house using scrap</String><String name="SHOP_AVAILABLE_MANA">Mana:</String><String name="SHOP_LIGHT3_TITLE">Eternal Glow</String><String name="SHOP_LIGHT3_BUY">Are you sure that you want to buy Eternal Glow?</String><String name="SHOP_LIGHT3_DESC">Eternal Glow will work forever</String><String name="SHOP_LIGHT3_LONGDESC">Eternal Glow is the strongest of the glows. It will be active for the remainder of the game.</String><String name="SHOP_LIGHT3_SELL">Are you sure that you want to sell Eternal Glow for</String><String name="ART_SHARE_MSG">Share your\nachievements:</String><String name="ART_COMPLETE_MSG">Congratulations!\nYou've discovered a new artifact!\n%s</String><String name="ART_BUY_ATTEMPTS_MSG">Do you want to replenish the amount of attempts?</String><String name="TUTORIAL_GOAL">Goal</String><String name="TUTORIAL_TAP_ELEMENT">Tap an\nelement</String><String name="TUTORIAL_TAP_GROUP_TO_EXPAND">Tap to open</String><String name="TUTORIAL_TAP_GROUP_TO_COLLAPSE">Tap to close</String><String name="TUTORIAL_NOTE_NEW_ELEMENT">New element\ncreated</String><String name="LAYOUT_HELP2_TEXT_ORANGE2">You can buy all of the frames and other useful items in the store</String><String name="HINT1_DLG_REMAIN">%d</String><String name="HINT2_DLG_REMAIN">%d</String><String name="HINT3_DLG_REMAIN">%d</String><String name="HINT_DLG_USE_HINT">Use a hint!</String><String name="HINT_DLG_BUY_HINT">Get more</String><String name="BTN_SUBMIT">Submit</String><String name="BTN_BUY_ATTEMPTS">Buy attempts</String><String name="PUZ_BUY_UNDO_MSG">Buy %d reaction cancels?</String><String name="PUZ_NOTING_UNDO">There's nothing to cancel</String><String name="CONTINUE">Continue</String><String name="MESSAGEBOX_SHARE_REACTION">Do you want to share this reaction with friends?</String><String name="PLAYMENU_SCR_ENCYCLOPEDIA">Encyclopedia</String><String name="SHOP_CONFIRM_PURCHASE_WORST_PENTAGRAM">Are you sure that you want to buy a pentagram worse than the one you have?</String><String name="QUESTS_SCR_20TH">Greatest Inventions</String><String name="QUESTS_SCR_20TH_DESC">Reinvent all of the wonderful things from the 20th century.</String><String name="TEASER_20TH_1_CAPTION">Greatest Inventions:</String><String name="TEASER_20TH_1_1">'Humans are exceptionally\n good at technology.'</String><String name="TEASER_20TH_1_2">'Let's see their\n latest inventions.'</String><String name="TEASER_20TH_2_CAPTION">Greatest Inventions:</String><String name="TEASER_20TH_2_1">'Now humans can perform miracles\n or destroy everything.'</String><String name="TEASER_20TH_2_2">What they will choose?</String><String name="SHOP_HINT3_LONGDESC">Each Free Reaction hint performs one reaction for you. It is a pack of 10 hints.</String><String name="SHOP_HINT3_LONGDESC_F2P">Each Free Reaction hint performs one reaction for you. Glow power will be spent on the reaction. It is a pack of 10 hints.</String><String name="HINT_DLG_USE_SEACRH">Use search!</String><String name="QUEST_PASS_EPISODE1_TO_UNLOCK">You must complete the first episode in order to continue.</String><String name="QUEST_PASS_EPISODE2_TO_UNLOCK">You must complete the second episode in order to continue.</String><String name="QUEST_PASS_EPISODE3_TO_UNLOCK">You must complete the third episode in order to continue.</String><String name="QUEST_PASS_EPISODE4_TO_UNLOCK">You must complete the fourth episode in order to continue.</String><String name="MINIGAME_OPEN_ELEMENT_TO_UNLOCK">You must unlock the element "Games" in the main game to continue.</String><String name="SETTINGS_PANE_PRIVACY_POLICY">Privacy Policy</String><String name="DAILY_BONUS">Daily Bonus</String><String name="DAILY_BONUS_DESC">Play everyday and get mana and super-prizes!</String><String name="DAILY_BONUS_OPEN">Open</String><String name="DAILY_BONUS_DAY">Day %s</String><String name="SHOP_MANA_TITLE">Mana</String><String name="SHOP_MANA_DESC">Mana is used to purchase hints, frames etc.</String><String name="NO_AD_DESC">Remove ads.</String><String name="NO_AD_DESC2">Ads removed.</String><String name="SHOP_MANA_LONGDESC">Mana is the ingame currency used to purchase new hints, element frames, etc.</String><String name="SHOP_PUZZLE_UNDO_TITLE">Undo puzzle reaction</String><String name="SHOP_PUZZLE_UNDO_DESC">Reverts last reaction in puzzle.</String><String name="SHOP_PUZZLE_UNDO_LONGDESC">Reverts last reaction in puzzle.</String><String name="OPTIONS_SCR_FACEBOOK">Login to Facebook</String><String name="OPTIONS_SCR_TWITTER">Login to Twitter</String><String name="OPTIONS_SCR_GOOGLEPLUS">Login to Google+</String><String name="PUZ_LOCOMOTIVE_WIN_MSG">Congratulations! You were able to create a locomotive using stuff that you already had! </String><String name="PUZ_SKYSCRAPER_WIN_MSG">Making a skyscraper from sand and stone is difficult, even if you are God! However, you've done it!</String><String name="PUZ_FLOWER_WIN_MSG">Ah, another miracle! You've turned harmful weapons into a beautiful flower!</String><String name="PUZ_ICE_CREAM_WIN_MSG">Excellent! Now you know what to do when you want ice cream.</String><String name="PUZ_TAVERN_WIN_MSG">You are the great architect!</String><String name="PUZ_CHRISTMAS_DECOR_WIN_MSG">Ringing in Christmas and the new year would be fun in this house</String><String name="PUZ_HELP_LP1_T3">3) Hooray! You've just created a new element!</String><String name="PUZ_HELP_RP1_T1">5) To combine like elements, there should be two or more.</String><String name="PUZ_HELP_RP1_T2">6) There's no point in wasting elements. You can sometimes come to a standstill, so you'll need them for new reactions.</String><String name="PUZ_HELP_RP1_T3">7) You can cancel your last action or start the puzzle over.</String><String name="PUZ_HELP_RP1_T4">8) The goal of every puzzle is to create the specified element.</String><String name="HINT_PUZZLE_DEADEND">Unfortunately, the puzzle can't be solved from this state. Undo the last reactions or start from scratch.</String><String name="PLAY_MENU_MODE">Game Modes</String><String name="PLAY_MENU_MAIN">Episodes</String><String name="PLAY_MENU_QUEST">Quests</String><String name="PLAY_MENU_PUZZLE">Puzzles</String><String name="PLAY_MENU_RESET_MAIN">Start the episode all over</String><String name="PLAY_MENU_RESET_QUEST">Start the quest all over</String><String name="PLAY_MENU_RESET_PUZZLE">Start the puzzle all over</String><String name="PLAY_MENU_ARTIFACTS">Artifacts</String><String name="PLAY_MENU_ARTIFACTS_NAME">%s</String><String name="CREDITS_HEADER_RIGHT">Games</String><String name="TWITTER_SENT_FAIL">Error sending tweet. Maybe try again later?</String><String name="TWITTER_SENT_SUCCESS">Your tweet has been sent successfully</String><String name="FACEBOOK_SENT_FAIL">Error posting to Facebook. Maybe try again later?</String><String name="FACEBOOK_SENT_SUCCESS">Message has been posted successfully</String><String name="GOOGLEPLUS_SENT_FAIL">Error posting to Google+. Maybe try again later?</String><String name="GOOGLEPLUS_SENT_SUCCESS">Message has been posted successfully</String><String name="SHOP_BONUS_BTN_VIEWOFFERS">Free</String><String name="SHOP_BONUS_BTN_INSTALLOFFERS">Install</String><String name="SHOP_BONUS_DESC_VIEWOFFERS">View Offers!</String><String name="SHOP_BONUS_MESSAGEBOX_VIEWOFFERS">This is for you:</String><String name="SHOP_BONUS_BTN_WATCHVIDEO">Free</String><String name="SHOP_BONUS_DESC_WATCHVIDEO">Watch Video!</String><String name="SHOP_BONUS_MESSAGEBOX_WATCHVIDEO">This is for you:</String><String name="SERVER_REWARD_BONUS_MESSAGEBOX">This is for you:</String><String name="SHOP_BONUS_BTN_FACEBOOK">Free</String><String name="SHOP_BONUS_DESC_FACEBOOK">Like us on Facebook!</String><String name="SHOP_BONUS_MESSAGEBOX_FACEBOOK">You liked us on Facebook. This is for you:</String><String name="SHOP_BONUS_BTN_TWITTER">Free</String><String name="SHOP_BONUS_DESC_TWITTER">Follow us on Twitter</String><String name="SHOP_BONUS_MESSAGEBOX_TWITTER">You became our follower on Twitter. This is for you:</String><String name="SHOP_BONUS_BTN_DOWNLOAD">Free</String><String name="SHOP_BONUS_DESC_DOWNLOAD">Download DoodleDevil</String><String name="SHOP_BONUS_MESSAGEBOX_DOWNLOAD">You downloaded DoodleDevil. This is for you:</String><String name="SHOP_BONUS_BTN_SUBSCRIBE">Free</String><String name="SHOP_BONUS_DESC_SUBSCRIBE">Subscribe to the newsletter</String><String name="SHOP_BONUS_MESSAGEBOX_SUBSCRIBE">You subscribed to the newsletter. This is for you:</String><String name="SHOP_BONUS_BTN_INVITE">Free</String><String name="SHOP_BONUS_DESC_INVITE">Invite a friend to play</String><String name="SHOP_BONUS_MESSAGEBOX_INVITE">You invited a friend. This is for you:</String><String name="SHOP_BONUS_BTN_REVIEW">Free</String><String name="SHOP_BONUS_DESC_REVIEW">Leave a comment</String><String name="SHOP_BONUS_MESSAGEBOX_REVIEW">You left a comment. This is for you:</String><String name="SHOP_BONUS_SALE_PERCENTS">%s%%\noff</String><String name="SHOP_PRICE_UNAVAILABLE">Unavailable</String><String name="SHOP_INAPP_ERROR">An error occurred during your purchase. Try again later.</String><String name="INAPP_STORE_ERROR">There is a problem with the store</String><String name="INAPP_LIMIT_REACHE