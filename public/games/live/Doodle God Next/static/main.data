t</String><String name="Chariot">Strijdwagen</String><String name="Drowned">Verdronken</String><String name="Fire elemental">Vuurelement</String><String name="Flatlands">Platteland</String><String name="Forge">Smeden</String><String name="Gem">Edelsteen</String><String name="Grave">Graf</String><String name="Graveyard">Kerkhof</String><String name="Iceberg">IJsberg</String><String name="Innkeeper">Herbergier</String><String name="Knight">Ridder</String><String name="Lake">Meer</String><String name="Lumber">Hout</String><String name="Mermaid">Meermin</String><String name="Militia">Militie</String><String name="Mill">Molen</String><String name="Mine">Mijn</String><String name="Necklace">Halsband</String><String name="Noble">Nobel</String><String name="Omelet">Omelet</String><String name="Ore">Erts</String><String name="Parchment">Perkament</String><String name="Peasant">Boer</String><String name="Plow">Ploeg</String><String name="Plowman">Ploeger</String><String name="Power">Kracht</String><String name="Ram">Ram</String><String name="Ranger">Boswachter</String><String name="Ruins">RuÃ¯ne</String><String name="Rusty weapon">Roestig wapen</String><String name="Siege tower">Belegeringstoren</String><String name="Smith">Smid</String><String name="Soup">Soep</String><String name="Stone circle">Stenencirkel</String><String name="Village">Dorp</String><String name="Water lily">Waterlelie</String><String name="Bee">Bij</String><String name="Pickaxe">Houweel</String><String name="T-Rex">T-Rex</String></Localization><?xml version="1.0" encoding="utf-8"?><Localization><String name="INAPP_STARTER_KIT_DESC"/><String name="NO_ADS">No Ads</String><String name="UPDATE_TO_A_NEW_APP">Deze versie wordt niet meer ondersteund . Sla je voortgang en update naar de nieuwe app .</String><String name="MUSIC_QUERY_TEXT">Wilt u blijven luisteren naar uw muziek ?</String><String name="MUSIC_QUERY_CAPTION">Muziek</String><String name="MUSIC_QUERY_DISABLE_GAMEMUSIC">Ja</String><String name="MUSIC_QUERY_DISABLE_PLAYER">Nee</String><String name="MESSAGEBOX_YES_SUPER_OFFER">Haal 't NU</String><String name="MESSAGEBOX_NO_SUPER_OFFER">Annuleren</String><String name="MESSAGEBOX_NO2_SUPER_OFFER">I need to think</String><String name="MESSAGEBOX_MINP_NAME_1">ACTIE!</String><String name="MESSAGEBOX_MINP_NAME_2">ACTIE!</String><String name="MESSAGEBOX_MINP_INFO_1">Add 1$ and get %s mana! Time is limited!</String><String name="MESSAGEBOX_MINP_INFO_2">Are you sure?</String><String name="MESSAGEBOX_BLITZ_REACTIONS">reacties</String><String name="MESSAGEBOX_GO_TO_WIKI">Naar Wikipedia-website</String><String name="TRY_OTHER">Probeer ook andere games van JoyBits</String><String name="MESSAGEBOX_RATE_TITLE">Vind je de game leuk?</String><String name="MESSAGEBOX_RATE_NEW">Laat het ons weten! Beoordeel onze toepassing!</String><String name="MESSAGEBOX_RATE_NEW_LOWRATE">Dank je wel!</String><String name="TO_THE_BANK_BUTTON">Naar de bank</String><String name="CROSS_PROMO_DESC_DD">Ontdek je duistere kant!</String><String name="CROSS_PROMO_DESC_DK">Het is tijd om MIDDELEEUWS te gaan!</String><String name="CROSS_PROMO_DESC_DC_DF">Schep een  wonderlijke wezens!</String><String name="CROSS_PROMO_DESC_DT_DF">Het is tijd om oorlog te voeren!</String><String name="UNLOCK_FULL_VERSION_BY_MOBILE">Unlock volledige versie het gebruik van mobiele</String><String name="MAINMENU_SCR_EXIT_BTN">Stoppen</String><String name="UNLOCK_QUEST">Wil je deze zoektocht ontgrendelen?</String><String name="UNLOCK_PUZZLE">Wil je deze puzzel ontgrendelen?</String><String name="CROSS_PROMO_TEXT_DG">Laat je verbeelding de vrije loop en wees een God </String><String name="CROSS_PROMO_TEXT_DD">Combineer vuur, aarde, water en lucht om demonen, beesten en zombies te scheppen... en nog veel meer!</String><String name="ARTIFACT_NOTIF_MSG">Tijd om nieuwe kunstvoorwerpen te scheppen in Doodle God.</String><String name="LOCKED">Locked</String><String name="CLICK">Klikken</String><String name="INFINITE_MANA">Oneindig mana</String><String name="MAINMENU_SCR_CREDITS_BTN">Credits</String><String name="MAINMENU_SCR_OPTIONS_BTN">Opties</String><String name="MAINMENU_SCR_PLAY_BTN">Spelen</String><String name="MAINMENU_SCR_UNIVERSE_BTN">Doodle\n Universe</String><String name="PVP_PLAY">Spelen %s{{img=message_box/energy_card.png}}</String><String name="REACTION_POWER">Lichtvermogen:\n%s</String><String name="REACTION_POWER_NO_TEXT">%d%%</String><String name="REACTION_RESULT_NEW_ELEMENT">Nieuw element aangemaakt!</String><String name="REACTION_RESULT_NEW_ELEMENT_PLURAL">Nieuwe elementen\naangemaakt!</String><String name="STATUS_BAR_ELEMENTS">Elementen: %s/%s</String><String name="STATUS_BAR_GROUPS">Groepen: %s/%s</String><String name="STATUS_BAR_REACTIONS">Reacties: %s/%s</String><String name="STATUS_BAR_SEPARATOR">/</String><String name="STATUS_BAR_PROGRESS">Voortgang zoektocht: %s%%</String><String name="STATUS_BAR_PROGRESS_PUZZLE">Voortgang puzzel: %s%%</String><String name="OPTIONS_SCR_TITLE">Opties</String><String name="OPTIONS_SCR_SOUND">Geluid</String><String name="OPTIONS_SCR_VOICE">Stem</String><String name="OPTIONS_SCR_MUSIC">Muziek</String><String name="OPTIONS_SCR_KIDS_ON">Veiligheidsmodus voor kinderen AAN</String><String name="OPTIONS_SCR_KIDS_OFF">Veiligheidsmodus voor kinderen UIT</String><String name="OPTIONS_SCR_NOTIFICATIONS">Mededelingen</String><String name="OPTIONS_TOOLBAR_LANGUAGE_BTN">DU</String><String name="OPTIONS_SCR_VIBRATION">Vibratie</String><String name="PLAYMENU_SCR_MAIN_GAME">Hoofdspel</String><String name="PLAYMENU_SCR_MAIN_GAME_ONE_LINE">Hoofdspel</String><String name="PLAYMENU_SCR_QUESTS">Opdrachten</String><String name="PLAYMENU_SCR_PUZZLES">Puzzels</String><String name="PLAYMENU_SCR_ARTIFACTS">Kunstvoorwerpen</String><String name="PLAYMENU_SCR_MINI_GAMES">Minigames</String><String name="QUESTS_SCR_RUN_SANTA">Rennen, Sint, rennen!</String><String name="QUESTS_SCR_RUN_SANTA_DESC">Help de Sint om cadeautjes te maken.</String><String name="QUESTS_SCR_PRINCESS">Red de prinses</String><String name="QUESTS_SCR_PRINCESS_DESC">van de draak, niet voor niets natuurlijk</String><String name="QUESTS_SCR_DEVIL_VS_GOD">Duivel vs. God</String><String name="QUESTS_SCR_DEVIL_VS_GOD_DESC">Maak deugden als tegenmaatregel tegen zonden.</String><String name="QUESTS_SCR_SURVIVOR">Survivor</String><String name="QUESTS_SCR_SURVIVOR_DESC">Ontsnap van het eiland in het midden van de oceaan.</String><String name="PUZZLES_SCR_LOCOMOTIVE">Locomotive</String><String name="PUZZLES_SCR_LOCOMOTIVE_DESC">Maak van eenvoudige\nelementen</String><String name="PUZZLES_SCR_SKYSCRAPER">Wolkenkrabber</String><String name="PUZZLES_SCR_SKYSCRAPER_DESC">Maak van zand\nen steen</String><String name="PUZZLES_SCR_CHRISTMAS_DECOR">Kerstversiering</String><String name="PUZZLES_SCR_CHRISTMAS_DECOR_DESC">Versier je huis</String><String name="MINI_GAMES_SCR_BEJOINED">Bejoined</String><String name="MINI_GAMES_SCR_MATCHTRIX">MatchTrix</String><String name="MINI_GAMES_SCR_SCORES">Scores:</String><String name="TREE_MAIN_GAME_TITLE">Episode\nselecteren</String><String name="TREE_MAIN_GAME_TITLE_RESET">Episode\nopnieuw instellen</String><String name="TREE_MAIN_GAME_LABEL_MAGIC">Magie</String><String name="TREE_MAIN_GAME_LABEL_NO_MAGIC">Geen magie</String><String name="TREE_MAIN_GAME_MAGIC">Wereld van magie</String><String name="TREE_MAIN_GAME_MAGIC_DESC">200+ elementen</String><String name="TREE_MAIN_GAME_MODERN">Nieuwe Tijd</String><String name="TREE_MAIN_GAME_MODERN_DESC">140 elementen</String><String name="TREE_MAIN_GAME_TECHNOLOGY">Technologie</String><String name="TREE_MAIN_GAME_TECHNOLOGY_DESC">100 elementen</String><String name="TREE_MAIN_GAME_BASIC">Begin</String><String name="TREE_MAIN_GAME_BASIC_DESC">4 elementen</String><String name="TREE_MAIN_GAME_CLICKED_COMPLETED_EPISODE">Je hebt deze | episode al voltooid, wil je | deze bekijken?</String><String name="TEASER1_SKIP">(overslaan)</String><String name="TEASER1_CAPTION">Intro:</String><String name="TEASER1_1">In het begin was er\nalleen Doodle God.</String><String name="TEASER1_2">Doodle God schiep de\nvier basiselementen ...</String><String name="TEASER1_3">Uit de aarde schiep\nDoodle God de planeten ...</String><String name="TEASER1_4">Uit water werden zeeÃ«n en oceanen gemaakt ...</String><String name="TEASER1_5">Uit vuur werden vulkanen... en andere dingen gemaakt...</String><String name="TEASER1_6">Uit lucht ... je weet wel ... Lucht...</String><String name="TEASER1_7">Maar de wereld was nog steeds groot en verlaten...</String><String name="TEASER1_8">... en toen kreeg Doodle God een briljant idee!</String><String name="TEASER1_9">'Wat als ik de basiselementen combineer om nieuwe elementen te creÃ«ren?'</String><String name="TEASER1_10">En Doodle God begon nieuwe elementen te creÃ«ren...</String><String name="TEASER1_11">'Wow! Er is zoveel te combineren, zoveel te creÃ«ren! '</String><String name="TEASER2_CAPTION">Episode twee</String><String name="TEASER2_1">Doodle God deed een stap terug om het geschapene te bekijken...</String><String name="TEASER2_2">En hij bemerkte de oneindige leegte overal...</String><String name="TEASER2_3">De leegte kan ook een goed element voor schepping zijn...</String><String name="TEASER2_4">En aldus verklaarde Doodle God ...</String><String name="TEASER2_5">'Laat ik het nu toevoegen aan mijn lijst'</String><String name="TEASER3_CAPTION">Episode drie</String><String name="TEASER3_1">Laat er vandaag in de wereld\neen veelheid aan verscheidenheid zijn</String><String name="TEASER3_2">Maar voorwaar! Sommige dingen\nkunnen gewoon niet naast elkaar bestaan!</String><String name="TEASER3_3">En ja, wat als de\nwerelden werden gescheiden</String><String name="TEASER3_4">En hun bewoners werd toegestaan\neen eigen pad toegestaan?</String><String name="TEASER3_5">"Om zeker te zijn'-\nberedeneerde Doodle God -</String><String name="TEASER3_6">'Ze zullen wijsheid,\nkennis en eh.. al die dingen nodig hebben. '</String><String name="TEASER4_CAPTION">Episode vier</String><String name="TEASER4_1">Doodle God dacht dat het\neen zeer geweldig idee zou zijn ...</String><String name="TEASER4_2">... om de scheppingsmacht\n te geven aan de mens.</String><String name="TEASER4_3">Want zij zullen in staat zijn om\nde wereld te veranderen zoals zij wensen.</String><String name="TEASER4_4">'Oeps, ze vonden net een\nskelet in de kast'</String><String name="TEASER4_5">Hoe dan ook, eens zien of\nze dapper genoeg zijn\nom ermee om te gaan!</String><String name="TEASER_Q1_CAPTION">Rennen, Sint, rennen</String><String name="TEASER_Q1_1">Sint heeft net bedacht dat er\niet genoeg cadeautjes zijn gemaakt.</String><String name="TEASER_Q1_2">En er is\nniet veel tijd meer.</String><String name="TEASER_Q1_3">O, jee!</String><String name="TEASER_Q1_4">We moeten opschieten\nen meer cadeautjes maken!</String><String name="TEASER_Q2_CAPTION">Red de prinses:</String><String name="TEASER_Q2_1">Ons koninkrijk is\ngetroffen door een zware tragedie!</String><String name="TEASER_Q2_2">Maar gelukkig hebben we\ngenoeg helden die kunnen helpen!</String><String name="TEASER_Q2_FIN_CAPTION">Gefeliciteerd!</String><String name="TEASER_Q2_FIN_1">Ze leefden nog lang\nen gelukkig...</String><String name="TEASER_Q2_FIN_2">...en stierven\nop dezelfde dag.</String><String name="TEASER_Q3_CAPTION">Duivel vs. God:</String><String name="TEASER_Q3_1">Doodle Duivel vond\nveel slechte dingen uit!</String><String name="TEASER_Q3_2">Doodle God besloot\ndeugden te scheppen als tegenmaatregel</String><String name="TEASER_QLOST_CAPTION">Survivor:</String><String name="TEASER_QLOST_1">Je ging je vervelen op het onbewoonde eiland\n en besloot na te denken over ontsnappen</String><String name="TEASER_QLOST_KNIFE_CAPTION">Mes</String><String name="TEASER_QLOST_KNIFE_1">Je hebt net het mes ontdekt.</String><String name="TEASER_QLOST_MAP_CAPTION">Kaart</String><String name="TEASER_QLOST_MAP_1">Je hebt net de kaart ontdekt.</String><String name="PINCODE_SCR_ENTER">Voer geheime\npincode in:</String><String name="PINCODE_SCR_CREATE">Maak geheime\npincode:</String><String name="PINCODE_SCR_RETYPE">Typ geheime pincode\nopnieuw in:</String><String name="LANGUAGE_SCR_TITLE">Taal</String><String name="HINT_DLG_HINT_1">Toon element</String><String name="HINT_DLG_HINT_2">Toon groepen</String><String name="HINT_DLG_HINT_3">Gratis reactie</String><String name="HINT_DLG_REMAIN">Hints over: %d</String><String name="HINT_DLG_USE">Gebruiken</String><String name="HINT_NO_ELEMENTS_CANT_DO">Je hebt geen elementen voor een reactie. Ontgrendel een inactief element.</String><String name="HINT1_TITLE">Hint:</String><String name="HINT2_TITLE">Sommige van deze\nelementen kunnen reageren:</String><String name="HINT1_WHATIF">Wat gebeurt er\nals ik %s maak?</String><String name="HINT1_BUT_HOW">Maar hoe?</String><String name="TAP_TO_CONTINUE">(tik om verder te gaan)</String><String name="CREDITS_RATE">Houd er rekening mee\ndat je 5-sterren reviews\nje helpen om updates\nte krijgen!</String><String name="LOG_SRC_TITLE">Geschiedenis reacties</String><String name="ALPHABET_SCR_TITLE">Ontdekte elementen,\nalfabetisch</String><String name="HELP_SCR_TITLE">Speluitleg</String><String name="HELP_SCR_TEXT1">1) Twee groepen\nuitvouwen</String><String name="HELP_SCR_TEXT2">2) Combineer twee\nelementen</String><String name="HELP_SCR_TEXT3">3) VoilÃ ! Je hebt zojuist\neen nieuw element gecreÃ«erd</String><String name="HELP_SCR_TEXT4">4) Maak meer dan 100 elementen als je je eigen universum bouwt!</String><String name="HELP_SCR_TEXT5">(laat je fantasie de vrije loop)</String><String name="HELP_SCR_TAP">Tik </String><String name="HELP2_SCR_TITLE">Speluitleg (2 van 2)</String><String name="HELP2_SCR_SOLID_FRAME">Klaar om te reageren of\nheb je geen andere frames</String><String name="HELP2_SCR_DOTTED_FRAME">Nog geen paar\n(probeer andere elementen)</String><String name="HELP2_SCR_GRAY_FRAME">Laatste element\n(geen nieuwe elementen uit deze)</String><String name="HELP2_SCR_ORANGE_FRAME">Element gemaakt met uitgewerkt Mana (geen reactie met dit element totdat de timer is ingeschakeld).</String><String name="SHOP_SCR_TITLE">Winkel</String><String name="SHOP_YOU_HAVE">Je hebt:</String><String name="SHOP_SCR_BUY">Kopen</String><String name="SHOP_SCR_SELL">Verkopen</String><String name="SHOP_WHEEL_TITLE">Rad van Fortuin</String><String name="SHOP_WHEEL_DESC">Bemachtig meer bonussen</String><String name="SHOP_HINT1_TITLE">Pak van 10 hints</String><String name="SHOP_HINT1_DESC">Hint laat je elementen\nzien die kunnen worden\ngemaakt op basis van bestaande</String><String name="SHOP_HINT1_LONGDESC">Iedere elementhint laat je Ã©Ã©n element zien dat zou kunnen worden gemaakt met de elementen die je al hebt. Je krijgt niet te zien hoe je dat element maakt.</String><String name="SHOP_HINT1_BUY">Weet je zeker dat je\neen pak van 10 elementhints\nwilt kopen voor</String><String name="SHOP_HINT2_TITLE">Pak van 10 hints</String><String name="SHOP_HINT2_DESC">Hint toont twee groepen\nwaar sommige elementen kunnen\nreageren</String><String name="SHOP_HINT2_LONGDESC">Iedere groepshint laat je twee groepen zien met elementen die absoluut reageren.</String><String name="SHOP_HINT2_BUY">Weet je zeker dat je\neen pak van 10 groephints wilt kopen voor</String><String name="SHOP_HINT3_TITLE">Pak van 10 hints</String><String name="SHOP_HINT3_DESC">Hint voert automatisch\neen willekeurige reactie\nvoor je uit</String><String name="SHOP_HINT3_BUY">Weet je zeker dat je\neen pak van 10 Gratis\nreactiehints wilt kopen voor</String><String name="SHOP_DOTTED_TITLE">Elementen zonder paren</String><String name="SHOP_DOTTED_DESC">Gestippelde rand voor\nelementen die geen paar\nhebben nu voor 24 uur</String><String name="SHOP_DOTTED_DESC_2">Gestippelde rand voor\nelementen die geen paar\nhebben nu voor %s uur</String><String name="SHOP_DOTTED_LONGDESC">Als je dit hebt gekocht, hebben alle elementen die op het moment geen koppel zijn (d.w.z. ze kunnen niet reageren) een stippellijn.</String><String name="SHOP_DOTTED_BUY">Weet je zeker dat je\nGestippelde rand wilt kopen\nvoor</String><String name="SHOP_DOTTED_SELL">Weet je zeker dat je\nGestippelde rand wilt verkopen\nvoor</String><String name="SHOP_GRAY_TITLE">Toon laatste elementen</String><String name="SHOP_GRAY_DESC">Blauwe rand voor elementen die definitief zijn voor de huidige episode voor 24 uur</String><String name="SHOP_GRAY_DESC_2">Blauwe rand voor elementen die definitief zijn voor de huidige episode voor %s uur</String><String name="SHOP_GRAY_LONGDESC">Als je dit hebt gekocht, hebben alle elementen die geen koppel zijn in de huidige episode een blauwe rand.</String><String name="SHOP_GRAY_BUY">Weet je zeker dat je blauwe rand wilt kopen voor</String><String name="SHOP_GRAY_SELL">Weet je zeker dat je blauwe rand wilt verkopen voor</String><String name="SHOP_NO_REPEAT_TITLE">Herhaling uitschakelen</String><String name="SHOP_NO_REPEAT_DESC">Schakelt reacties uit die\nal zijn ontdekt</String><String name="SHOP_NO_REPEAT_LONGDESC">Door dit item te kopen staat God je niet toe reacties uit te voeren die je al hebt ontdekt.</String><String name="SHOP_NO_REPEAT_LONGDESC_F2P">Schakelt reacties uit die al zijn ontdekt. Door dit item te kopen staat God je niet toe reacties uit te voeren die je al hebt ontdekt. Dit is goed voor gloedvermogen en voor je zenuwen.</String><String name="SHOP_NO_REPEAT_BUY">Weet je zeker dat je\nHerhaling uitschakelen wilt kopen voor</String><String name="SHOP_NO_REPEAT_SELL">Weet je zeker dat\nje Herhaling uitschakelen wilt verkopen\nvoor</String><String name="SHOP_LIGHT1_TITLE">Goddelijke gloed</String><String name="SHOP_LIGHT1_BUY">Weet je zeker dat je Goddelijke gloed wilt kopen</String><String name="SHOP_LIGHT1_DESC">Goddelijke gloed bedient %s elementen</String><String name="SHOP_LIGHT1_LONGDESC">Goddelijke gloed is essentieel voor elementreacties. Met iedere reactie vervaagt de gloed een beetje verder. Gloed wordt ververst zichzelf na enige tijd (uren).</String><String name="SHOP_LIGHT2_TITLE">Onbevlekte gloed</String><String name="SHOP_LIGHT2_BUY">Weet je zeker dat je Onbevlekte gloed wilt kopen</String><String name="SHOP_LIGHT2_DESC">Onbevlekte gloed bedient %s elementen</String><String name="SHOP_LIGHT2_LONGDESC">Onbevlekte gloed is krachtiger - het kan meer reacties aan dan Goddelijke gloed.</String><String name="SHOP_ALREADY_BOUGHT">Je hebt dit item al gekocht!</String><String name="SHOP_NO_MANA">Niet genoeg manna</String><String name="SHOP_PAY_BY_SMS">Betalen met sms</String><String name="PINCODE_WRONG_CODE">Onjuiste pincode.\nProbeer het nogmaals.</String><String name="DISMISS">OK</String><String name="MESSAGEBOX_MORE">Meer</String><String name="MESSAGEBOX_CANCEL">Annuleren</String><String name="MESSAGEBOX_RESET_CONFIRM">Alle vorderingen in deze episode worden gewist en de episode wordt opnieuw gestart. Weet je het zeker?</String><String name="MESSAGEBOX_RESET_CONFIRM_QUEST">Alle vorderingen op deze\nzoektocht worden gewist en\nde episode wordt opnieuw gestart.\nWeet je het zeker?</String><String name="MESSAGEBOX_YES">Ja</String><String name="MESSAGEBOX_NO">Nee</String><String name="MESSAGEBOX_GHOST_ELEMENT_BUY">Maak element "%s" actief voor</String><String name="QUEST1_PROGRESS_OBJECTIVES">Doelstellingen: Maak geschenken voor iedereen!\nOpmerking: Sommigen willen meer dan Ã©Ã©n geschenk.</String><String name="QUEST1_COMPLETE">Gefeliciteerd!\nAlle geschenken zijn afgeleverd!</String><String name="QUEST2_PROGRESS_OBJECTIVES">Doelstellingen: Dood de draak, red de prinses, ontvang een beloning.\n\\Opmerking: pas op voor valstrikken.</String><String name="QUEST2_COMPLETE">Gefeliciteerd!\nde Prinses is gered!</String><String name="QUEST3_PROGRESS_OBJECTIVES">Doelstellingen: maak minimaal\ndrie deugden als tegenmaatregel tegen iedere zonde.</String><String name="QUEST3_COMPLETE">Gefeliciteerd!\n\nNu is het kwaad overwonnen!</String><String name="QUESTLOST_PROGRESS_OBJECTIVES">Doelstellingen: maak iets om \nvan het eiland te ontsnappen.</String><String name="QUESTLOST_COMPLETE_SUCCESS_TITLE">Gefeliciteerd! Je bent ontsnapt!</String><String name="QUESTLOST_COMPLETE_KILLED_TITLE">Je bent gedood door piraten!</String><String name="QUESTLOST_COMPLETE_TORTURE_TITLE">De piraten hebben je schat gestolen en je teruggegooid op het eiland.</String><String name="QUESTLOST_COMPLETE_KILLED">Je bent gedood door piraten! Al je inspanningen om te ontsnappen van het eiland zijn mislukt!</String><String name="QUESTLOST_COMPLETE_SUCCESS">Gefeliciteerd! Je bent van het onbewoonde eiland ontsnapt en naar het vasteland teruggekeerd als een zeer rijk man! Al je inspanningen en ontberingen waren niet voor niets!</String><String name="QUESTLOST_COMPLETE_TORTURE">De piraten hebben je schat gestolen en je teruggegooid op het eiland. Er is een kans dat je de rest van je leven hier zult blijven.</String><String name="GO_MOBILE_BTN">Word\nmobiel</String><String name="RESET_CONFIRM">Je voortgang gaat verloren. Weet je zeker dat je wilt resetten?</String><String name="REVIEW_PROMPT">Als je Doodle God leuk vindt\nbeoordeel het dan met 5 sterren.</String><String name="TEASER_SKIP_BTN">Overslaan</String><String name="SNAPPED_PROMPT">Zorg voor volledig scherm om Doodle God te spelen</String><String name="PORTRAIT_PROMPT">Zorg voor landschapsmodus om Doodle God te spelen</String><String name="EPISODE_FINISHED_SIGN">OK</String><String name="EPISODE_FINISHED_DIALOG_PROMPT">Je hebt deze test episode afgerond!</String><String name="SHARE_TITLE">Doodle God</String><String name="SHARE_DEFAULT_DESC"/><String name="SHARE_BODY_FOOTER_LINK">&lt;br&gt;&lt;br&gt;&lt;link href="www.doodlegod.com"&gt;www.doodlegod.com&lt;/link&gt;</String><String name="SHARE_DEFAULT_BODY">Ik speel nu Doodle God op Windows 8!!!&lt;br&gt;&lt;br&gt;&lt;link href="www.doodlegod.com"&gt;www.doodlegod.com&lt;/link&gt;</String><String name="SHARE_NEW_REACTION_BODY">Ik heb een nieuwe reactie ontdekt:&lt;b&gt;&lt;br&gt;%s&lt;/b&gt;</String><String name="SHARE_NEW_REACTION_DESC">Nieuw element aangemaakt</String><String name="SHARE_EPISODE_FINISHED_BODY">Ik heb afgerond &lt;b&gt;"%s";&lt;/b&gt;</String><String name="SHARE_EPISODE_FINISHED_DESC"/><String name="IN_APP_ERROR">Oeps... Het lukt nu niet\nProbeer het later nogmaals</String><String name="UNLOCK_THANKS">Dank je wel</String><String name="DAY_THANKS">Dank je wel!</String><String name="NO_MORE_HINTS_DAILY">Probeer morgen meer hints te krijgen</String><String name="GAME_OVER_TEXT">Gefeliciteerd!\nJe hebt de game\nafgerond</String><String name="UPDATE_AVAILABLE">Nieuwe update\nbeschikbaar</String><String name="UPDATE_COMING_SOON">Binnenkort\nnieuwe updates!</String><String name="RATE_AND_REVIEW">Beoordeel en review</String><String name="REVIEW_PROMPT_2">Vergeet niet te beoordelen met 5 sterren en reviews zodat er meer updates komen</String><String name="UNLOCK_BTN_GET_FULL">Haal de volledige game</String><String name="UPDATE_BTN">Nu\nupdaten</String><String name="TILE_main_game_1">Episode I: Het Begin</String><String name="TILE_main_game_2">Episode II: Technologie</String><String name="TILE_main_game_3">Episode III: Nieuwe Tijd</String><String name="TILE_main_game_4">Episode IV: Wereld van magie</String><String name="EPISODE2_LOCKED_MESSAGE">Je moet\n'Episode Ã©Ã©n: Het Beginâ€™ voltooien</String><String name="EPISODE3_LOCKED_MESSAGE">Je moet\n'Episode twee: Technologieâ€™ voltooien</String><String name="EPISODE4_LOCKED_MESSAGE">Je moet\n'Episode drie: Nieuwe Tijdâ€™ voltooien</String><String name="HELP_CAPTION">Speluitleg:</String><String name="FINISH_CAPTION">Goed gedaan! en bedankt\nvoor je slimme spel!</String><String name="FINISH_TEXT">Seconden geleden heb je 100 elementen gecreÃ«erd en het spel voltooid.\nIn de volledige versie van het spel krijg je vier episodes, nieuwe zoektochten en minigames, talloze gloednieuwe reacties en beroemde citaten.</String><String name="EXTRA_HINTS">Extra hints</String><String name="EXTRA_HINTS_CAPTION">Extra hints:</String><String name="EXTRA_HINTS_YOU_HAVE">Je hebt momenteel</String><String name="EXTRA_HINTS_COUNT">500</String><String name="EXTRA_HINTS_EXTRA_HINTS">extra hints</String><String name="EXTRA_HINTS_DESCRIPTION">Met extra hints hoef je niet\nte wachten op een herlading</String><String name="EXTRA_HINTS_TIMER">2:47</String><String name="EXTRA_HINTS_RECHARGE_NOW">NU\nHERLADEN</String><String name="EXTRA_HINTS_GET_MORE">Zorg voor meer\nExtra Hints</String><String name="TRIAL_SCREEN_PLAYER">Beste\nspeler</String><String name="TRIAL_SCREEN_FINISHED">Je hebt deze gratis episode afgerond</String><String name="TRIAL_SCREEN_PROMPT">Wil je meer?\nUpgrade naar de volledige versie en ontvang een volledige set premium onderdelen:</String><String name="TRIAL_SCREEN_PROMPT_NO_COLON">Wil je meer?\nUpgrade naar de volledige versie en ontvang een volledige set premium onderdelen.</String><String name="TRIAL_SCREEN_UNLOCK_DESC">Ontgrendel nu alle onderdelen en ga\nverder met spelen</String><String name="TRIAL_SCREEN_UNLOCK_BTN">Koop\nnu</String><String name="TRIAL_SCREEN_DOWNLOAD_DESC">Download de volledige\nversie van de Store</String><String name="TRIAL_SCREEN_DOWNLOAD_BTN">Haal volledige</String><String name="TRIAL_BTN">Haal 't NU</String><String name="MAINMENU_SCR_UNLOCK_FULL_BTN">Alles vrijspelen</String><String name="MAINMENU_SCR_REVIEW_BTN">Review</String><String name="MAINMENU_SCR_UPDATE_NEW_BTN">Updates</String><String name="GAMEOVER_TEXT">Om verder te kunnen gaan, heb je een verplichte update nodig met massa's extra functies en content.</String><String name="UPDATE_TXT">Update</String><String name="PUZ_TARGET_MSG">Je doel is om element "%s" te vinden</String><String name="PUZ_WIN_MSG">Gefeliciteerd!\n Je bent een natuurtalent!</String><String name="PUZ_PASSED_MSG">Je hebt deze puzzel al voltooid. Probeer een andere!</String><String name="PUZ_NO_FREE_SLOT_MSG">Er is geen ruimte voor toekomstige elementen.</String><String name="PUZ_NO_ENOUGH_ELE_MSG">Je hebt niet genoeg elementen voor een reactie.</String><String name="CONTINUE">Doorgaan</String><String name="PASS_PREV_EPISODE_TO_UNLOCK">Je moet de vorige episode voltooien om door te kunnen gaan.</String><String name="MESSAGEBOX_LANG_CONFIRM">Weet je zeker dat je de taal wilt veranderen?</String><String name="PUZ_HELP_P1_M1">1) Kies twee elementen</String><String name="PUZ_HELP_P2_M1">2) Je krijgt nieuwe elementen voor iedere reactie</String><String name="PUZ_HELP_P3_M1">3) De elementen die in reacties worden gebruikt, verdwijnen. Je kunt twee of meer elementen krijgen</String><String name="PUZ_HELP_P4_M1">4) Combineer elementen en los de puzzel op</String><String name="OPTIONS_AUTO_LANGUAGE">Auto</String><String name="PUZZLES_SCR_LOCOMOTIVE">Locomotief in het bos</String><String name="PUZZLES_SCR_LOCOMOTIVE_DESC">Maak een locomotief van eenvoudige dingen.</String><String name="PUZZLES_SCR_SKYSCRAPER">Wolkenkrabber</String><String name="PUZZLES_SCR_SKYSCRAPER_DESC">Bouw een wolkenkrabber van zand en steen</String><String name="PUZZLES_SCR_ICECREAM">Elementaire ijsco</String><String name="PUZZLES_SCR_ICECREAM_DESC">Maak een ijsco van basiselementen</String><String name="PUZZLES_SCR_FLOWER">In de naam van de vrede</String><String name="PUZZLES_SCR_FLOWER_DESC">Maak een bloem van een atoombom</String><String name="SHOP_AVAILABLE_MANA">Mana:</String><String name="SHOP_LIGHT3_TITLE">Eeuwige gloed</String><String name="SHOP_LIGHT3_BUY">Weet je zeker dat je Eeuwige  gloed wilt kopen?</String><String name="SHOP_LIGHT3_DESC">Eeuwige gloed werkt voor eeuwig</String><String name="SHOP_LIGHT3_LONGDESC">Eeuwige gloed is de sterkste gloed die er is. Hij is actief voor de rest van het spel.</String><String name="SHOP_LIGHT3_SELL">Weet je zeker dat je Eeuwige gloed wilt verkopen voor</String><String name="ART_SHARE_MSG">Deel je\nresultaten:</String><String name="ART_COMPLETE_MSG">Gefeliciteerd!\nJe hebt een nieuw kunstvoorwerp ontdekt!\n%s</String><String name="ART_BUY_ATTEMPTS_MSG">Wil je het aantal pogingen bijvullen?</String><String name="TUTORIAL_GOAL">Doelpunt!</String><String name="TUTORIAL_TAP_ELEMENT">Tik op een\nelement</String><String name="TUTORIAL_TAP_GROUP_TO_EXPAND">Tik om\nopen te maken</String><String name="TUTORIAL_TAP_GROUP_TO_COLLAPSE">Tik om\ndicht te maken</String><String name="TUTORIAL_NOTE_NEW_ELEMENT">Nieuwe element\ngemaakt</String><String name="LAYOUT_HELP2_TEXT_ORANGE2">Je kunt alle kaders en andere nuttige items in de winkel kopen</String><String name="HINT1_DLG_REMAIN">%d</String><String name="HINT2_DLG_REMAIN">%d</String><String name="HINT3_DLG_REMAIN">%d</String><String name="HINT_DLG_USE_HINT">Gebruik een hint!</String><String name="HINT_DLG_BUY_HINT">Haal meer</String><String name="BTN_SUBMIT">Verzenden</String><String name="BTN_BUY_ATTEMPTS">Koop pogingen</String><String name="PUZ_BUY_UNDO_MSG">Wil je %d reactie-annuleringen kopen?</String><String name="PUZ_NOTING_UNDO">Er is niets te annuleren</String><String name="CONTINUE">Doorgaan</String><String name="MESSAGEBOX_SHARE_REACTION">Wil je deze reactie met vrienden delen?</String><String name="PLAYMENU_SCR_ENCYCLOPEDIA">Encyclopedie</String><String name="SHOP_CONFIRM_PURCHASE_WORST_PENTAGRAM">Weet je zeker dat je een pentagram wilt kopen die slechter is dan die je hebt?</String><String name="QUESTS_SCR_20TH">Grootste uitvindingen</String><String name="QUESTS_SCR_20TH_DESC">Vind alle geweldige dingen van de 20e eeuw opnieuw uit.</String><String name="TEASER_20TH_1_CAPTION">Grootste uitvindingen:</String><String name="TEASER_20TH_1_1">'Mensen zijn uitzonderlijk\n goed in technologie.'</String><String name="TEASER_20TH_1_2">'Laten we hun\n nieuwste uitvindingen bekijken.'</String><String name="TEASER_20TH_2_CAPTION">Grootste uitvindingen:</String><String name="TEASER_20TH_2_1">'Mensen kunnen wondere verrichten\n of alles vernietigen.'</String><String name="TEASER_20TH_2_2">Wat zullen ze kiezen?</String><String name="SHOP_HINT3_LONGDESC">Iedere Gratis reactiehint voert Ã©Ã©n reactie voor je uit. Het is een pakket van 10 hints.</String><String name="SHOP_HINT3_LONGDESC_F2P">Iedere Gratis reactiehint voert Ã©Ã©n reactie voor je uit. Bij een reactie wordt gloedvermogen verbruikt. Het is een pakket van 10 hints.</String><String name="HINT_DLG_USE_SEACRH">Gebruik zoeken!</String><String name="QUEST_PASS_EPISODE1_TO_UNLOCK">Je moet de eerste aflevering voltooien om door te kunnen gaan.</String><String name="QUEST_PASS_EPISODE2_TO_UNLOCK">Je moet de tweede aflevering voltooien om door te kunnen gaan.</String><String name="QUEST_PASS_EPISODE3_TO_UNLOCK">Je moet de derde aflevering voltooien om door te kunnen gaan.</String><String name="QUEST_PASS_EPISODE4_TO_UNLOCK">Je moet de vierde aflevering voltooien om door te kunnen gaan.</String><String name="MINIGAME_OPEN_ELEMENT_TO_UNLOCK">Je moet het element "Wedstrijden" ontgrendelen in het hoofdspel om door te gaan.</String><String name="QUEST20TH_PROGRESS_OBJECTIVES">Je doel: De 10 belangrijkste uitvindingen van alle decennia van de 20e eeuw herontdekken.</String><String name="QUEST20TH_COMPLETE">Gefeliciteerd!\n\nJe bent de grootste uitvinder van de 20e eeuw!</String><String name="SETTINGS_PANE_PRIVACY_POLICY">Privacybeleid</String><String name="DAILY_BONUS">Dagelijkse bonus</String><String name="DAILY_BONUS_OPEN">Openen</String><String name="BANK_ACTION_FULL_MSG">tot einde verkoop</String><String name="GAMEOVER_ANY_PLAY">Probeer andere gametypen!</String><String name="GAMEOVER_UPDATE_TEXT">Vergeet de updates niet!\nBinnenkort komen er meer!</String><String name="SHOP_BONUSPACK_TITLE">Bonuskist</String><String name="SHOP_BONUSPACK_BUY">Weet je zeker dat je Bonuskist wilt kopen?</String><String name="SHOP_BONUSPACK_DESC">Bonuskist bevat handige dingen.</String><String name="SHOP_BONUSPACK_LONGDESC">Starterset bevat een willekeurige hoeveelheid mana, diverse hints en andere nuttige dingen.</String><String name="SHOP_STARTERKIT_DESC">Bonuskist bevat handige dingen.</String><String name="SALE_TITLE">Super Sale!</String><String name="PINCODE_TITLE">Toegangsbeperking voor volwassenenmodus</String><String name="CREDITS_HEADER_RIGHT">Games</String><String name="DAILY_BONUS_COME_TOMORROW">Kom morgen terug voor nieuwe prijzen!</String><String name="DAILY_BONUS_DAY">Dag %s</String><String name="FACEBOOK_SENT_FAIL">Fout bij het plaatsen op Facebook. Later nogmaals proberen?</String><String name="FACEBOOK_SENT_SUCCESS">Bericht is geplaatst</String><String name="GOOGLEPLUS_SENT_FAIL">Fout bij het plaatsen op Google+. Later nogmaals proberen?</String><String name="GOOGLEPLUS_SENT_SUCCESS">Bericht is geplaatst</String><String name="HINT_PUZZLE_DEADEND">De puzzel kan vanuit deze staat helaas niet worden opgelost. Maak de laatste reacties ongedaan of begin helemaal opnieuw.</String><String name="INAPP_LIMIT_REACHED">Oeps... Je hebt je limiet bereikt. Probeer het morgen opnieuw!</String><String name="INAPP_STORE_ERROR">Er is een probleem met de winkel</String><String name="OPTIONS_SCR_BONUS">Haal bonussen</String><String name="OPTIONS_SCR_FACEBOOK">Meld je aan op Facebook</String><String name="OPTIONS_SCR_TWITTER">Meld je aan op Twitter</String><String name="OPTIONS_SCR_GOOGLEPLUS">Meld je aan op Google+</String><String name="PLAY_MENU_ARTIFACTS">Kunstvoorwerpen</String><String name="PLAY_MENU_ARTIFACTS_NAME">%s</String><String name="PLAY_MENU_MAIN">Afleveringen</String><String name="PLAY_MENU_MODE">Gametypen</String><String name="PLAY_MENU_PUZZLE">Puzzels</String><String name="PLAY_MENU_QUEST">Zoekopdrachten</String><String name="PLAY_MENU_RESET_MAIN">Begin de aflevering helemaal opnieuw</String><String name="PLAY_MENU_RESET_PUZZLE">Begin de hersenbreker helemaal opnieuw</String><String name="PLAY_MENU_RESET_QUEST">Begin de zoektocht helemaal opnieuw</String><String name="PUZ_ICE_CREAM_WIN_MSG">Uitstekend! Nu weet je wat je moet doen als je een ijsje wilt.</String><String name="PUZ_TAVERN_WIN_MSG">U bent de grote architect!</String><String name="PUZ_HELP_LP1_T1">1) Open twee groepen</String><String name="PUZ_HELP_LP1_T2">2) Kies twee elementen</String><String name="PUZ_HELP_LP1_T3">3) Hoera! Je hebt zojuist een nieuw element gecreÃ«erd!</String><String name="PUZ_HELP_LP1_T4">4) De elementen die in reacties worden gebruikt, verdwijnen.</String><String name="PUZ_HELP_RP1_T1">5) Je moet twee of meer elementen hebben om ze te kunnen combineren.</String><String name="PUZ_HELP_RP1_T2">6) Het is zinloos elementen te verspillen. Je kunt soms vast komen te zitten, dus je hebt ze nodig voor nieuwe reacties.</String><String name="PUZ_HELP_RP1_T3">7) Je kunt je laatste actie annuleren of de puzzel opnieuw beginnen.</String><String name="PUZ_HELP_RP1_T4">8) Het doel van elke puzzel is om het opgegeven element te maken.</String><String name="PUZ_FLOWER_WIN_MSG">Ah! Weer een wonder! Je hebt schadelijke wapens omgezet in een prachtige bloem!</String><String name="PUZ_LOCOMOTIVE_WIN_MSG">Gefeliciteerd! Je hebt een locomotief gemaakt met de dingen die je al had!</String><String name="PUZ_MSG_RESET_CONFIRM">Wil je de puzzel opnieuw beginnen?</String><String name="PUZ_SKYSCRAPER_WIN_MSG">Een wolkenkrabber maken uit zand en steen is moeilijk, zelfs als je god bent! Maar je hebt het voor elkaar gekregen!</String><String name="PUZ_CHRISTMAS_DECOR_WIN_MSG">Kerst en het nieuwe jaar inluiden in dit huis zou leuk zijn</String><String name="SHOP_BONUS_BTN_VIEWOFFERS">Gratis</String><String name="SHOP_BONUS_BTN_INSTALLOFFERS">Install</String><String name="SHOP_BONUS_DESC_VIEWOFFERS">Bekijk de aanbiedingen!</String><String name="SHOP_BONUS_MESSAGEBOX_VIEWOFFERS">Dit is voor jou:</String><String name="SHOP_BONUS_BTN_WATCHVIDEO">Gratis</String><String name="SHOP_BONUS_DESC_WATCHVIDEO">Bekijk de video!</String><String name="SHOP_BONUS_MESSAGEBOX_WATCHVIDEO">Dit is voor jou:</String><String name="SERVER_REWARD_BONUS_MESSAGEBOX">Dit is voor jou:</String><String name="MESSAGEBOX_SET_BONUSES_ON">Als je bonussen wilt activeren moet je instemmen met het optionele systeemdialoogvenster direct hierna</String><String name="MESSAGEBOX_SET_BONUSES_OFF">Weet je zeker dat geen bonussen meer wilt ontvangen?</String><String name="SHOP_BONUS_BTN_DOWNLOAD">Gratis</String><String name="SHOP_BONUS_BTN_FACEBOOK">Gratis</String><String name="SHOP_BONUS_BTN_INVITE">Gratis</String><String name="SHOP_BONUS_BTN_REVIEW">Gratis</String><String name="SHOP_BONUS_BTN_SUBSCRIBE">Gratis</String><String name="SHOP_BONUS_BTN_TWITTER">Gratis</String><String name="SHOP_BONUS_DESC_DOWNLOAD">Download DoodleDevil</String><String name="SHOP_BONUS_DESC_FACEBOOK">Vind ons leuk op Facebook!</String><String name="SHOP_BONUS_DESC_INVITE">Nodig een vriend uit om te spelen</String><String name="SHOP_BONUS_DESC_REVIEW">Laat een opmerking achter</String><String name="SHOP_BONUS_DESC_SUBSCRIBE">Abonneer je op de nieuwsbrief</String><String name="SHOP_BONUS_DESC_TWITTER">Volg ons op Twitter</String><String name="SHOP_BONUS_MESSAGEBOX_DOWNLOAD">Je hebt DoodleDevil gedownload. Dit is voor jou:</String><String name="SHOP_BONUS_MESSAGEBOX_FACEBOOK">Je vindt ons leuk op Facebook! Dit is voor jou:</String><String name="SHOP_BONUS_MESSAGEBOX_INVITE">Je hebt een vriend uitgenodigd. Dit is voor jou:</String><String name="SHOP_BONUS_MESSAGEBOX_REVIEW">Je hebt een opmerking achtergelaten. Dit is voor jou:</String><String name="SHOP_BONUS_MESSAGEBOX_SUBSCRIBE">Je hebt je geabonneerd op de nieuwsbrief. Dit is voor jou:</String><String name="SHOP_BONUS_MESSAGEBOX_TWITTER">Je volgt ons nu op Twitter. Dit is voor jou:</String><String name="SHOP_BONUS_SALE_PERCENTS">%s%%\nkorting</String><String name="SHOP_INAPP_ERROR">Er is een fout opgetreden bij je aankoop. Probeer het later opnieuw.</String><String name="SHOP_INAPP_SUCCESS_MESSAGE">Gefeliciteerd! Je hebt echt leuke dingen gekocht!</String><String name="SHOP_MANA_DESC">Manna wordt gebruikt om hints, kaders enz. te kopen.</String><String name="NO_AD_DESC">Remove ads.</String><String name="NO_AD_DESC2">Ads removed.</String><String name="SHOP_MANA_LONGDESC">Manna is de geldeenheid in het spel om nieuwe hints, elementkaders enz. te kopen.</String><String name="SHOP_MANA_TITLE">Manna</String><String name="SHOP_PRICE_UNAVAILABLE">Niet beschikbaar</String><String name="SHOP_PUZZLE_UNDO_DESC">Maakt de laatste reactie in de puzzel ongedaan.</String><String name="SHOP_PUZZLE_UNDO_LONGDESC">Maakt de laatste reactie in de puzzel ongedaan.</String><String name="SHOP_PUZZLE_UNDO_TITLE">Puzzelreactie ongedaan maken</String><String name="STATUS_BAR_ACTION_TEXT">Actietijd over</String><String name="TWITTER_SENT_FAIL">Fout bij verzenden tweet. Later nogmaals proberen?</String><String name="TWITTER_SENT_SUCCESS">Je tweet is verstuurd.</String><String name="UNIVERSE_DD_TXT1">- Meer dan 100.000.000 spelers wereldwijd!</String><String name="UNIVERSE_DD_TXT2">- Ontdek je duistere kant!</String><String name="UNIVERSE_DD_TXT3">- Verken de zeven doodzonden en zie hoe de wereld wordt vernietigd door jouw daden!</String><String name="UNIVERSE_DD_TXT4">Ontdek verschillende combinaties van vuur, lucht, water en aarde om demonen, monsters, zombies en nog veel meer te maken. Speel de duivelse fruitautomaat met duivelse munten!</String><String name="UNIVERSE_DF_DOWNLOAD_TXT">Download deze game op je platform:</String><String name="UNIVERSE_DF_TXT1">- Meer dan 100.000.000 spelers wereldwijd!</String><String name="UNIVERSE_DF_TXT2">- Haal schattige dieren naar je boerderij!</String><String name="UNIVERSE_DF_TXT3">- Geniet van een fantastische wereld aan schepsels. Zet je cowboyhoed op en begin het op je eigen manier te doen.</String><String name="UNIVERSE_DF_TXT4">Weet je hoe je een hond of tijger maakt? Welke dieren vormen tezamen een nieuw dier? Wordt kat + hond = tijger? Of eend + haring = pinguÃ¯n? En kan een pinguÃ¯n vliegen? Ontdek een compleet dierenkoninkrijk dat met slechts vier schepsels begint!</String><String name="UNIVERSE_DG_DOWNLOAD_TXT">Download deze game op je platform:</String><String name="UNIVERSE_DG_TXT1">- Meer dan 100.000.000 hebben de afgelopen maand geprobeerd een eigen wereld te scheppen!</String><String name="UNIVERSE_DG_TXT2">- Maak meer dan 300 geavanceerde items en concepten!</String><String name="UNIVERSE_DG_TXT3">- Laat de god in je zien met Doodle God!</String><String name="UNIVERSE_DG_TXT4">Doodle God legt de macht om te scheppen in jouw handen. Meng verschillende elementen en pas ze bij elkaar om van bacteriÃ«n naar kevers te gaan, van klei naar keramiek, van gereedschappen naar wapens en nog verder!</String><String name="UNIVERSE_IC_DOWNLOAD_TXT">Download deze game op je platform:</String><String name="UNIVERSE_IC_TXT1">- Leuke hockeywedstrijden en spannende toernooien liggen op je te wachten!</String><String name="UNIVERSE_IC_TXT2">- Werk je omhoog van amateur naar professional met je groep!</String><String name="UNIVERSE_IC_TXT3">- Vind zeldzame kunstvoorwerpen en maak je team tot het sterkste in de stad met Icy Clash!</String><String name="UNIVERSE_IC_TXT4">Bouw stadions en smederijen en train je spelers voor glorieuze overwinningen! Vergeet niet je fans naar je vrienden te sturen voor ondersteuning!</String><String name="UNIVERSE_DK_TXT1">- Meer dan 100.000.000 spelers wereldwijd!</String><String name="UNIVERSE_DK_TXT2">- Bouw je eigen magische wereld!</String><String name="UNIVERSE_DK_TXT3">- Geniet van drie boeiende zoekopdrachten met een pakkend verhaal!</String><String name="UNIVERSE_DK_TXT4">Help je held een machtige ridder te worden en versla monsters die overmijdelijk in je wereld zullen opduiken!</String><String name="UNIVERSE_DC_TXT4">In Doodle Creatures kom je daarachter als je honderden fantastische en unieke wezens schept door verschillende dieren te combineren.</String><String name="W8_SHARE_INVITE_DESCRIPTION">Uitnodiging</String><String name="W8_SHARE_INVITE_BODY">&lt;a href="{free_version_link}"&gt;&lt;img src="http://www.doodlegod.com/doodlegod/images/728x90.jpg" &gt;&lt;/a&gt;&lt;br&gt;Hi!&lt;br&gt;Iâ€™k speel de Doodle God en ik kan er niet genoeg van krijgen. &lt;a href="{free_version_link}"&gt;Jij vindt het ook leuk.&lt;/a&gt;&lt;br&gt; Het is een kans om god te spelen! Maak allerlei combinaties van vuur, water, aarde en lucht om een beschaving te scheppen in deze verslavende puzzelgame!&lt;br&gt;&lt;br&gt;&lt;a href="http://www.doodlegod.com"&gt;www.doodlegod.com&lt;/a&gt;</String><String name="W8_SHARE_INVITE_TITLE">Games JoyBits</String><String name="W8_SUBSCRIBE_BODY">Wees de eerste die op de hoogte is van nieuwe versies, gamenieuws, acties en promoties dankzij een nieuwsbrief van JoyBits Ltd.</String><String name="W8_SUBSCRIBE_SUBJECT">Ja. Ik wil het nieuws van JoyBits Ltd ontvangen.</String><String name="OSX_SHARE_INVITE_DESCRIPTION">Uitnodiging</String><String name="OSX_SHARE_INVITE_BODY">Iâ€™k speel de Doodle God en ik kan er niet genoeg van krijgen. Jij vindt het ook leuk. Het is een kans om god te spelen! Maak allerlei combinaties van vuur, water, aarde en lucht om een beschaving te scheppen in deze verslavende puzzelgame!</String><String name="QUEST_GAME_CLICKED_COMPLETED_EPISODE">Je hebt deze zoektocht al voltooid, wil je hem nogmaals bekijken?</String><String name="PUZZLE_GAME_CLICKED_COMPLETED_EPISODE">Je hebt deze puzzel al voltooid, wil je hem nogmaals bekijken?</String><String name="SHOP_DISCOUNTS_ANNOUNCE_MSG">Uitverkoop! Sommige prijzen zijn tijdelijk verlaagd!</String><String name="TRIAL_SCREEN_AD_EPISODES">Vier Spannende Episodes</String><String name="TRIAL_SCREEN_AD_QUESTS">Grootse zoekopdrachten</String><String name="TRIAL_SCREEN_AD_PUZZLES">Hersenbrekende puzzels</String><String name="TRIAL_SCREEN_AD_ARTIFACTS">Unieke kunstvoorwerpen</String><String name="QUEST_UNLOCK_NOTIF_MSG">Zoektocht %s is nu beschikbaar</String><String name="PUZZLE_UNLOCK_NOTIF_MSG">Puzzel %s is nu beschikbaar</String><String name="SHARE_ARTIFACT_CREATED">Ik heb voorwerp %s in elkaar gezet in Doodle God!</String><String name="FIRST_VISIT_BONUS">Bonus voor eerste bezoek</String><String name="ACTION_NOTIF_SHOP_MSG">Nieuwe kortingen in de winkel! Wil je meer informatie?</String><String name="ACTION_NOTIF_BANK_MSG">Nieuwe bonussen in de bank! Wil je meer informatie?</String><String name="ART_IS_LOCKED_MSG">Voorwerpen worden ongrendeld bij het openen van de belangrijkste game-elementen.</String><String name="MAINMENU_SCR_FEEDBACK_BTN">Feedback</String><String name="MAINMENU_SCR_FEEDBACK_SUBJECT">Feedback over %s</String><String name="MAINMENU_SCR_FEEDBACK_BODY">\n\nOmschrijf hierboven je probleem en kijk uit dat je de ID die daaronder staat niet verwijdert.\n</String><String name="SHOP_SCR_RESTORE">Herstellen</String><String name="SHOP_MSG_CHOOSE_ACTION">Kies een actie</String><String name="MESSAGEBOX_SHARE_ARTIFACT">Wil je dit kunstvoorwerp met vrienden delen?</String><String name="DAILY_BONUS_DESC">Speel elke dag en ontvang manna en superprijzen!</String><String name="DAILY_BONUS_DESC_REQ_REACTION">Combineer elke dag elementen en ontvang manna en superprijzen!</String><String name="DAILY_BONUS_DESC_REQ_NEW_ELEMENT">Ontdek elke dag nieuwe elementen en ontvang manna en superprijzen!</String><String name="MESSAGEBOX_SHARE_ELEMENT">Wil je dit element met vrienden delen?</String><String name="MESSAGE_SHARE_ELEMENT">Kijk eens wat voor geweldige dingen je kunt maken in Doodle God!</String><String name="MESSAGEBOX_CONTINUE">Doorgaan</String><String name="MESSAGEBOX_TUTORIAL_HINT_DIALOG_F2P">Je kunt elke dag nieuwe hints krijgen! Of ze in de winkel kopen.</String><String name="MESSAGEBOX_TUTORIAL_HINT_DIALOG_PAID">Hints worden over enkele minuten vernieuwd! Of je kunt ze in de winkel kopen.</String><String name="TRIAL_SCREEN_RESTORE_DESC">Herstel je eerdere aankopen</String><String name="MESSAGEBOX_RESTORE_INAPPS">Alle vorige permanente aankopen zoals Eeuwige Gloed en Volledig Spel Vrijspelen (voor gratis versie) worden hersteld. Aankopen van extraâ€™s zoals Manna en Hints worden niet hersteld.</String><String name="MESSAGEBOX_RESTORE_INAPPS_OK">OK</String><String name="MESSAGEBOX_RESTORE_INAPPS_CA