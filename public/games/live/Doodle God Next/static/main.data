<Layout x="32" y="200" width="256" height="129" animate="EfxPopup" blackener="none" >
    <BlackenerImage name="click_blocker" image="/message_box/white.png" visible="1" color="00000000" touch_stop="1"/>
    <Image name="bkg" x="0" y="0" width="256" height="129" image="/message_box/Slot_message.png"/>
    
    <Widget name="message_field" x="15" y="12" width="226" height="70">
        <Text name="message" x="0" y="0" width="226" height="70" font="baloo_bold_medium" lineHeight="16" autoFit="1" align="C" color="FF320c04" />
        <PriceTag name="price" x="-10" y="120" width="260" height="17" font="font" lineHeight="20" align="W" color="FF67390F" space="3"/>
    </Widget>

    <Button name="left" x="20" y="85" width="101" height="35" image="/message_box/Btn_blue.png">
        <Text name="left_text" x="5" y="0" width="90" height="35" font="baloo_bold_medium" align="C" text="Yes" autoFit="1" color="FF320c04" />
    </Button>

    <Button name="right" x="135" y="85" width="101" height="35"image="/message_box/Btn_blue.png">
        <Text name="right_text" x="5" y="0" width="90" height="35" font="baloo_bold_medium" align="C" text="No" autoFit="1" color="FF320c04" />
    </Button>
    
    <Button name="middle" x="77" y="85" width="101" height="35" image="/message_box/Btn_blue.png">
        <Text name="middle_text" x="5" y="0" width="90" height="35" font="baloo_bold_medium" align="C" text="Dismiss" autoFit="1" color="FF320c04" />
    </Button>
</Layout>

