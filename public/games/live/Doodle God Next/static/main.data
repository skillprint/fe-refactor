ng name="GAMEOVER_QUESTION2">Want fully stuffed cool premium DG?</String><String name="GAMEOVER_QUESTION3">Unleash your Imagination and Play Full Game Now</String><String name="GAMEOVER_A_LOT_OF_TIME">I have a lot of time</String><String name="GAMEOVER_DOWNLOAD_BLITZ2">Download Blitz</String><String name="GAMEOVER_CONTINUE_FREE">Continue for free</String><String name="GAMEOVER_YEAH">Heck Yeah!</String><String name="GAMEOVER_NOPE">No thanks</String><String name="SHOP_BONUSPACK_TITLE">Bonus chest</String><String name="SHOP_BONUSPACK_BUY">Are you sure you want to buy Bonus chest?</String><String name="SHOP_BONUSPACK_DESC">Bonus chest contains useful stuff.</String><String name="SHOP_BONUSPACK_LONGDESC">Bonus chest contains a random set of mana, various hints and other useful stuff.</String><String name="SHOP_STARTERKIT_DESC">Starter kit contains useful stuff.</String><String name="SALE_TITLE">Super Sale!</String><String name="PINCODE_TITLE">Adult mode access restriction</String><String name="BANK_ACTION_FULL_MSG">until end of sale</String><String name="QUEST_GAME_CLICKED_COMPLETED_EPISODE">You've already finished this quest, do you want to see it again?</String><String name="PUZZLE_GAME_CLICKED_COMPLETED_EPISODE">You've already finished this puzzle, do you want to see it again?</String><String name="FIRST_VISIT_BONUS">First visit bonus</String><String name="QUEST_UNLOCK_NOTIF_MSG">Quest %s is now available</String><String name="PUZZLE_UNLOCK_NOTIF_MSG">Puzzle %s is now available</String><String name="SHARE_ARTIFACT_CREATED">I managed to assemble artifact %s in Doodle God game!</String><String name="ACTION_NOTIF_SHOP_MSG">New discounts in the shop! Want to know the details?</String><String name="ACTION_NOTIF_BANK_MSG">New bonuses in the bank! Want to know the details?</String><String name="TRIAL_SCREEN_AD_EPISODES">Four Exciting Episodes</String><String name="TRIAL_SCREEN_AD_QUESTS">Epic Quests</String><String name="TRIAL_SCREEN_AD_PUZZLES">Brainbusting Puzzles</String>