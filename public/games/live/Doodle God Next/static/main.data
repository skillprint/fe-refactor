AYS_1">Non perdere la tua fortuna! Il tuo bonus giornaliero ti aspetta.</String><String name="NOTIFY_7DAYS_2">Hai giÃ  scoperto quali nuovi elementi creare?</String><String name="NOTIFY_7DAYS_3">Su Doodle God sono cominciati sconti irripetibili.</String><String name="NOTIFY_7DAYS_4">L'elemento %s Ã¨ disponibile per una reazione.</String><String name="NOTIFY_7DAYS_5">Cosa accadrÃ  se creerai %s?</String><String name="NOTIFY_MAIN_GAME_ALL_1">Continua a giocare a Doodle God</String><String name="CONFIRM_NOTIFY_MAIN_GAME_ALL_1">Gioca</String><String name="NOTIFY_MAIN_GAME_ALL_2">Ritorna, hai creato solo una parte delle reazioni di Doodle God!</String><String name="CONFIRM_NOTIFY_MAIN_GAME_ALL_2">Gioca</String><String name="NOTIFY_MAIN_GAME_ALL_4">Hai idee per nuovi elementi?</String><String name="CONFIRM_NOTIFY_MAIN_GAME_ALL_4">Ne ho!</String><String name="NOTIFY_MAIN_GAME_1_1">L'universo di Doodle God attende il suo creatore!</String><String name="CONFIRM_NOTIFY_MAIN_GAME_1_1">Gioca</String><String name="NOTIFY_MAIN_GAME_1_2">Apri i mondi di Doodle God!</String><String name="CONFIRM_NOTIFY_MAIN_GAME_1_2">Apri</String><String name="NOTIFY_MAIN_GAME_2_1">Crea la rivoluzione industriale nel secondo episodio di Doodle God!</String><String name="CONFIRM_NOTIFY_MAIN_GAME_2_1">Gioca</String><String name="NOTIFY_MAIN_GAME_2_2">Il tuo mondo ha bisogno di nuove tecnologie!</String><String name="CONFIRM_NOTIFY_MAIN_GAME_2_2">Inventa</String><String name="NOTIFY_MAIN_GAME_3_1">La tua civiltÃ  desidera nuove invenzioni!</String><String name="CONFIRM_NOTIFY_MAIN_GAME_3_1">Gioca</String><String name="NOTIFY_MAIN_GAME_3_2">Crea tecnologie piÃ¹ avanzate e apparecchiature moderne!</String><String name="CONFIRM_NOTIFY_MAIN_GAME_3_2">Crea</String><String name="NOTIFY_MAIN_GAME_4_1">Il mondo di Doodle God desidera nuovi miracoli!</String><String name="CONFIRM_NOTIFY_MAIN_GAME_4_1">Gioca</String><String name="NOTIFY_MAIN_GAME_4_2">Nel mondo di Doodle God ci sono magia e miracoli che ti aspettano!</String><String name="CONFIRM_NOTIFY_MAIN_GAME_4_2">Gioca</String><String name="NOTIFY_QUEST_SANTA_1">Babbo Natale non riuscirÃ  a occuparsi di tutti i regali in tempo, aiutalo!</String><String name="CONFIRM_NOTIFY_QUEST_SANTA_1">Aiutalo</String><String name="NOTIFY_QUEST_SANTA_2">Aiuta Babbo Natale a trovare regali adatti per dei personaggi famosi!</String><String name="CONFIRM_NOTIFY_QUEST_SANTA_2">Aiutalo</String><String name="NOTIFY_QUEST_PRINCESS_1">Una bellissima principessa Ã¨ stata rapita da un drago. Solo tu puoi salvarla!</String><String name="CONFIRM_NOTIFY_QUEST_PRINCESS_1">Salvala!</String><String name="NOTIFY_QUEST_PRINCESS_2">Il re ha offerto un premio per chi salverÃ  la principessa! Vorresti ardire di completare questa missione?</String><String name="CONFIRM_NOTIFY_QUEST_PRINCESS_2">Voglio!</String><String name="NOTIFY_QUEST_GOOD_1">Chi vince in una battaglia tra il bene e il male? Spetta a te deciderlo.</String><String name="CONFIRM_NOTIFY_QUEST_GOOD_1">Gioca</String><String name="NOTIFY_QUEST_GOOD_2">Diavolo contro Dio. Da che parte stai?</String><String name="CONFIRM_NOTIFY_QUEST_GOOD_2">Scoprilo</String><String name="NOTIFY_QUEST_LOST_1">Metti alla prova la tua creativitÃ  su un'isola deserta.</String><String name="CONFIRM_NOTIFY_QUEST_LOST_1">Gioca</String><String name="NOTIFY_QUEST_LOST_2">Un coraggioso esploratore Ã¨ bloccato su un'isola deserta. Aiutalo ad andarsene!</String><String name="CONFIRM_NOTIFY_QUEST_LOST_2">Aiutalo!</String><String name="NOTIFY_QUEST_20_CENTURY_1"/><String name="CONFIRM_NOTIFY_QUEST_20_CENTURY_1">Gioca</String><String name="NOTIFY_QUEST_20_CENTURY_2"/><String name="CONFIRM_NOTIFY_QUEST_20_CENTURY_2">Gioca</String><String name="NOTIFY_PUZZLE_GENERIC_1">Metti alla prova la tua creativitÃ  creando oggetti comuni in modi insoliti nei rompicapo di Doodle God!</String><String name="CONFIRM_NOTIFY_PUZZLE_GENERIC_1">Gioca</String><String name="NOTIFY_PUZZLE_GENERIC_2">Pensa fuori da coro nei rompicapo di Doodle God!</String><String name="CONFIRM_NOTIFY_PUZZLE_GENERIC_2">Gioca</String><String name="NOTIFY_ARTIFACTS_1">Stai per creare degli Artefatti unici!</String><String name="CONFIRM_NOTIFY_ARTIFACTS_1">Gioca</String><String name="NOTIFY_ARTIFACTS_2">Hai raccolto tutto il set di Artefatti?</String><String name="CONFIRM_NOTIFY_ARTIFACTS_2">Raccogli</String><String name="NOTIFY_ARTIFACTS_3">In Doodle God oltre agli elementi comuni puoi creare anche potenti Artefatti!</String><String name="CONFIRM_NOTIFY_ARTIFACTS_3">Gioca</String><String name="NOTIFY_NUDGE_1">Non sai cosa fare? Prova {1} + {2}</String><String name="CONFIRM_NOTIFY_NUDGE_1">Gioca</String><String name="NOTIFY_NUDGE_2">Ora puoi creare {3}. Riuscirai a scoprire come?</String><String name="CONFIRM_NOTIFY_NUDGE_2">RiuscirÃ²</String><String name="NOTIFY_NUDGE_3">{1} + {2} = ?</String><String name="CONFIRM_NOTIFY_NUDGE_3">Gioca</String><String name="NOTIFY_NUDGE_4">Abbiamo bisogno della tua intelligenza! Ritorna e gioca</String><String name="CONFIRM_NOTIFY_NUDGE_4">Gioca</String><String name="NOTIFY_NUDGE_5">Ci manchi. Per favore, ritorna :)</String><String name="CONFIRM_NOTIFY_NUDGE_5">Gioca</String><String name="NOTIFY_HINT_1">Il tuo suggerimento si Ã¨ ricaricato!</String><String name="CONFIRM_NOTIFY_HINT_1">Gioca!</String><String name="NOTIFY_PENTAGRAM_1">Il tuo Bagliore si Ã¨ ricaricato! Ora puoi di nuovo creare elementi!</String><String name="CONFIRM_NOTIFY_PENTAGRAM_1">Gioca!</String></Localization><?xml version="1.0" encoding="utf-8"?><Localization><String name="MISSION_ELEMENT_NAME">Elemento "%s"</String><String name="MISSION_ELEMENT_DESC">Crea lâ€™elemento "%s" e ricevi una ricompensa!</String><String name="MISSION_ELEMENT_REWARD">Ricompensa per il completamento:</String><String name="MISSION_ELEMENT_CONGRATULATION">Congratulazioni!\nHai completato la missione "%s"!</String><String name="NEW_MISSION_AVAILABLE">Nuova missione disponibile</String><String name="NEW_MISSION">Nuova missione</String><String name="PLANET_NEW_FEATURE">Nuovo!</String><String name="PLANET_TUTORIAL">Quando scopri alcuni elementi speciali, questi vengono aggiunti al tuo mondo. PiÃ¹ elementi trovi, piÃ¹ bello diventa questo mondo!</String><String name="PLANET_HINT1">Tocca qui per creare nuovi elementi</String><String name="PLANET_HINT2">Completa le missioni per ottenere dei bonus!</String><String name="PLANET_HINT3">Tocca qui per visualizzare la missione in corso</String></Localization><?xml version="1.0" encoding="utf-8"?><Localization><String name="SOCIAL_TWITTER_TEMPLATE">Ho scoperto che %s + %s = %s! Prendere Doodle God -</String><String name="SOCIAL_ACHIEVEMENT_TEMPLATE">Splendido! Hai appena ottenuto un nuovo riconoscimento: "%s".\nCosa hai ottenuto in Doodle God?\nVisita il nostro sito www.doodlegod.com e leggi le ultime notizie.\nGioca a Doodle Devil: libera il tuo Lato Oscuro!</String><String name="SOCIAL_ACHIEVEMENT_TWITTER_TEMPLATE">Splendido! Hai appena ottenuto un nuovo riconoscimento: "%s".\nGioca a Doodle Devil: libera il tuo Lato Oscuro!</String></Localization><?xml version="1.0" encoding="utf-8"?><Localization><String name="C"/><String name="D"/><String name="Ã"/><String name="Ã„"/><String name="Ã…"/><String name="Ã‰"/><String name="ÃŽ"/><String name="Ã“"/><String name="Ã–"/><String name="Ãœ"/><String name="Ä„"/><String name="Ä†"/><String name="Ä˜"/><String name="Ä²"/><String name="Å"/><String name="Åƒ"/><String name="Å’"/><String name="Åš"/><String name="Å¹"/><String name="Å»"/></Localization><?xml version="1.0" encoding="utf-8"?><Localization><String name="ART_NAME_GODZILLA">Godzilla</String><String name="ART_DESC_GODZILLA">Godzilla Ã¨ un gigantesco mostro apparso per la prima volta nel film Godzilla del 1954.  Con i bombardamenti atomici di Hiroshima, Nagasaki, e l'incidente della Daigo FukuryÅ« Maru ancora freschi nell'immaginario giapponese, Godzilla fu concepito come un mostro creato dalle detonazioni nucleari, e in generale come metafora per le armi nucleari.</String><String name="ART_ENIG_GODZILLA">Un enorme mostro dalle profonditÃ  marine.</String><String name="ART_NAME_PERPET">Perpetuo</String><String name="ART_DESC_PERPET">Il moto di un'ipotetica macchina che, una volta attivata, avrebbe continuato a funzionare per sempre, a meno di non subire influenze esterne o rotture.</String><String name="ART_ENIG_PERPET">Impossibile macchina perpetua</String><String name="ART_NAME_TITANIC">Titanic</String><String name="ART_DESC_TITANIC">Il Titanic era una nave passeggeri che affondÃ² nell'oceano Atlantico settentrionale il 15 aprile 1912, dopo essersi scontrata con un iceberg durante il suo viaggio inaugurale da Southampton (Regno Unito) a New York (USA). L'affondamento del Titanic causÃ² la morte di 1502 persone in uno dei piÃ¹ disastrosi incidenti marittimi non bellici della storia moderna.</String><String name="ART_ENIG_TITANIC">L'ultimo grido in fatto di comoditÃ  e lusso. Annegato.</String><String name="ART_NAME_PBOX">La scatola di Pandora</String><String name="ART_DESC_PBOX">La scatola di Pandora Ã¨ un artefatto della mitologia greca. La â€œscatolaâ€ era in realtÃ  un grande otre dato a Pandora che conteneva tutti i mali del mondo. Oggi, la frase â€œaprire la scatola di Pandoraâ€ significa compiere un'azione che pare innocua, ma che in realtÃ  avrÃ  conseguenze serie e di grande portata.</String><String name="ART_ENIG_PBOX">Faresti meglio a non aprirla.</String><String name="ART_NAME_SHENGE">Stonehenge</String><String name="ART_DESC_SHENGE">Stonehenge Ã¨ un monumento preistorico nella contea inglese dello Wiltshire. Ãˆ stata prodotta da una cultura che non ha lasciato documenti scritti. Molti aspetti di Stonehenge sono a tutt'oggi fonte di dibattito. Questa molteplicitÃ  di teorie, alcune molto pittoresche, Ã¨ spesso chiamata il â€œmistero di Stonehengeâ€. Molti miti circondano queste pietre.</String><String name="ART_ENIG_SHENGE">Pietre misteriose</String><String name="ART_NAME_LSABER">Spada laser</String><String name="ART_DESC_LSABER">Una spada laser Ã¨ un'arma appartenente all'universo di Guerre Stellari. Consiste in un'elsa metallica rifinita che proietta una lama di plasma lunga circa 1,33 metri. La spada laser Ã¨ la tipica arma dell'ordine dei Jedi e dei loro nemici Sith, ed entrambi le utilizzano nel combattimento ravvicinato, o per deviare i colpi di una pistola laser.</String><String name="ART_ENIG_LSABER">Questo lo puoi risolvere solo se hai abbastanza midi-chlorian.</String><String name="ART_NAME_EIFTOWER">Torre Eiffel</String><String name="ART_DESC_EIFTOWER">Eretta nel 1889 come arco di ingresso della fiera mondiale, la Torre Eiffel Ã¨ diventata in tutto il mondo un'icona culturale francese e una delle strutture piÃ¹ facilmente riconoscibili. La torre Ã¨ la piÃ¹ alta struttura della cittÃ  e il monumento a pagamento piÃ¹ visitato del mondo. La torre raggiunge i 320 metri di altezza, circa come un edificio di 81 piani.</String><String name="ART_ENIG_EIFTOWER">Parigi, Parigi...</String><String name="ART_NAME_GRAIL">Il Sacro Graal</String><String name="ART_DESC_GRAIL">Un artefatto della mitologia cristiana, Ã¨ la coppa usata da Cristo durante l'ultima cena, in cui sarebbe conservato parte del suo sangue raccolto durante la crocifissione.</String><String name="ART_ENIG_GRAIL">Molte persone lo stanno cercando. Re ArtÃ¹, Indiana Jones...</String><String name="ART_NAME_ROP">Anello del potere</String><String name="ART_DESC_ROP">L'Unico Anello fu forgiato dall'oscuro signore Sauron durante la seconda etÃ  per ottenere il dominio sui liberi popoli della Terra di mezzo. Sauron lo creÃ² come il piÃ¹ potente degli Anelli del potere, in grado di dominare e controllare tutti coloro che indossavano gli altri Anelli. Essendo questi Anelli giÃ  potenti di per sÃ©, Sauron fu costretto a mettere molto del suo potere nell'Unico Anello per poter ottenere il suo scopo.</String><String name="ART_ENIG_ROP">Uno per il signore oscuro sul suo oscuro trono</String><String name="ART_NAME_PYRAMID">Piramide di Cheope</String><String name="ART_DESC_PYRAMID">In origine la piramide era coperta da uno strato di calcare ancora piÃ¹ duro dei blocchi che rivestiva. La piramide era coronata da una pietra dorata. Alla luce del sole, le sue facce emettevano una luce color pesca, â€œuna meraviglia scintillante a cui Ra, dio del Sole, deve aver donato tutti i suoi raggi.â€</String><String name="ART_ENIG_PYRAMID">Ãˆ lâ€™unica delle sette meraviglie del mondo antico che sia giunta fino ai giorni nostri</String><String name="ART_NAME_SPHYNX">Sfinge</String><String name="ART_DESC_SPHYNX">La statua della Sfinge Ã¨ rivolta verso il Nilo e il sole nascente. Quasi tutte le antiche civiltÃ  orientali vedevano nel leone un simbolo del dio Sole. La Sfinge era una sentinella che vigilava sul riposo eterno dei faraoni seppelliti attorno ad essa.</String><String name="ART_ENIG_SPHYNX">Un enorme leone con la testa di faraone.</String><String name="ART_NUM_OF_ATTEMPTS">Numero di tentativi</String><String name="ART_TIME_FOR_RESET_ATTEMPTS">Tempo rimasto prima di poter riprovare:</String><String name="ART_HINT_SHORT_DESC_FIFTY_FIFTY">Questo suggerimento nasconde metÃ  degli elementi non necessari per la creazione degli artefatti.</String><String name="ART_HINT_DESC_FIFTY_FIFTY">Questo suggerimento nasconde metÃ  degli elementi non necessari per la creazione degli artefatti. L'uso ripetuto nasconde metÃ  degli elementi rimanenti.</String><String name="ART_HINT_DESC_SHOW_GROUP">Questo suggerimento mostra i gruppi di tre elementi necessari per la creazione dell'artefatto.</String><String name="ART_HINT_SHORT_DESC_SHOW_ELE">Questo suggerimento sceglie un elemento corretto per la reazione.</String><String name="ART_HINT_DESC_SHOW_ELE">Questo suggerimento sceglie un elemento corretto per la reazione. Puoi utilizzare questo suggerimento ripetutamente per completare l'intera reazione.</String>Â  Â  <String name="ART_MSG_BUY_FIFTY_FIFTY">Vuoi davvero acquistare %d suggerimenti â€œ50/50â€?</String>Â  Â  <String name="ART_MSG_BUY_SHOW_GROUP">Vuoi davvero acquistare %d suggerimenti â€œGruppiâ€?</String>Â  Â  <String name="ART_MSG_BUY_SHOW_ELE">Vuoi davvero acquistare %d suggerimenti â€œElementoâ€?</String>    <String name="ART_STATUSMAR_MSG_LEFT">Scegli gli elementi</String>    <String name="ART_STATUSMAR_MSG_RIGHT">Crea artefatto</String>    <String name="MSG_NO_MANA">Mana insufficiente. Vuoi andare alla banca?</String>    <String name="ART_MSG_NO_MANA">Mana insufficiente. Vuoi andare alla banca?</String>    <String name="ART_HELP_P1_M1">1) Scegli 3 elementi qualsiasi dall'elenco</String>    <String name="ART_HELP_P2_M1">2) Combina i 3 elementi per creare un artefatto</String>    <String name="ART_HELP_P3_M1">3) Congratulazioni!</String>    <String name="ART_HELP_P3_M2">Hai scoperto un nuovo artefatto!</String>    <String name="ART_HELP_P4_M1">4) Ottieni l'intera collezione di artefatti</String>            <String name="ART_COMING_SOON">PRESTO DISPONIBILE</String>    <String name="ART_NAME_BASILISK">Basilisco</String>    <String name="ART_DESC_BASILISK">Nel medioevo si riteneva che i basilischi esistessero davvero. Secondo la credenza popolare i basilischi avevano zanne avvelenate, artigli e un soffio velenoso; in aggiunta, come Medusa, erano in grado di uccidere con lo sguardo.</String>    <String name="ART_ENIG_BASILISK">Una sola occhiata da questa creatura mostruosa ti trasformerebbe in pietra.</String>    <String name="ART_NAME_SLEDGE">Slitta di Babbo Natale</String>    <String name="ART_DESC_SLEDGE">In origine, la slitta di Babbo Natale veniva trainata da otto renne soltanto: Saetta, Ballerino, Schianto, Guizzo, Cometa, Cupido, Tuono e Lampo. Rudolph venne aggiunta alle otto renne nel 1939 da Robert L. May, e grazie a una canzone di Johnny Marks divenne ben presto la renna piÃ¹ famosa.</String>    <String name="ART_ENIG_SLEDGE">Cosa usa Babbo Natale per consegnare i suoi regali?</String>    </Localization><?xml version="1.0" encoding="utf-8"?><Localization><String name="CREDITS_ORIGINAL_IDEA">Idea originale</String><String name="CREDITS_GAME_DESIGNER">Game design</String><String name="CREDITS_LEAD_ARTIST">Direttore grafico</String><String name="CREDITS_ARTIST">Grafico</String><String name="CREDITS_PROGRAMMER">Sviluppo software</String><String name="CREDITS_SOUND">Audio</String><String name="CREDITS_SPECIAL_THANKS">Ringraziamenti speciali a:</String><String name="CREDITS_TRANSLATE">Localization</String><String name="Anton Rybakov">Anton Rybakov</String><String name="Nick Kotlyarov">Nick Kotlyarov</String><String name="Imya Familiya">Imya Familiya</String><String name="Alexey Krivorotko">Alexey Krivorotko</String><String name="Vladimir Schmidthof">Vladimir Schmidthof</String><String name="Strategic Music">Strategic Music</String><String name="Somatone Interactive">Somatone Interactive</String><String name="Elegar Helfrid">Elegar Helfrid</String><String name="Alexey Zbritsky">Alexey Zbritsky</String><String name="Alexey Dyadchanko">Alexey Dyadchenko</String><String name="Mihail Perepelkin">Mihail Perepelkin</String><String name="Alexey Schekin-Gelmer">Alexey Schekin-Gelmer</String><String name="Artem Titov">Artem Titov</String><String name="Vladimir Klubkov">Vladimir Klubkov</String><String name="Vitaliy Tulnikov">Vitaliy Tulnikov</String><String name="Roman Tikhomirov">Roman Tikhomirov</String><String name="Pavel Barto">Pavel Barto</String><String name="Alexander Jurgens">Alexander Jurgens</String><String name="Yaroslav Rudakov">Yaroslav Rudakov</String><String name="Eva Frolkina">Eva Frolkina</String><String name="Vitaliy Chernyshev">Vitaliy Chernyshev</String><String name="Andrey Lee">Andrey Lee</String><String name="Dmitry Kozlov">Dmitry Kozlov</String><String name="Alexander Anisimov">Alexander Anisimov</String><String name="Alexey Kochnev">Alexey Kochnev</String><String name="Alexander Gvozdikov">Alexander Gvozdikov</String><String name="Leonid Krot">Leonid Krot</String><String name="Oleg Grebnev">Oleg Grebnev</String><String