_if="$config.nav_quest_shop_enable == 1" name="navigate_inapp_badge" x="42" y="15" events="check_inapp_badge" width="10" height="10"><File>/interface/point_element.png</File><AnimController name="anim" autoPlay="0"><ActionChain><EfxWait duration="0.5"/><EfxScaleXY duration="0.2" mode="t" to_x="1.3" to_y="1.3"/><EfxScaleXY duration="0.2" mode="t" to_x="1.0" to_y="1.0"/><EfxScaleXY duration="0.2" mode="t" to_x="1.3" to_y="1.3"/><EfxScaleXY duration="0.2" mode="t" to_x="1.0" to_y="1.0"/></ActionChain></AnimController></InAppBadge></Widget><ToolbarButton name="log" x="260" y="0" image="/toolbar/log.png" xml="/interface/ui_enable_disable_animation.xml"><aAnimController autoPlay="1"><ActionGroup><EfxMove duration="0" to_x="260" to_y="0" mode="t"/></ActionGroup></aAnimController><Image name="badge" x="42" y="4" width="18" height="18"/><Click cmd="layout" param="ReactionLog"><Param value="crossfade"/></Click><Widget name="log_button_result_path_point" x="0" y="0" width="64" height="64"/><Widget name="fastMergeResultDest2" x="0" y="0"/><AnimController autoPlay="1"><ActionChain><EfxRotate mode="t" to="0" duration="0"/></ActionChain></AnimController><AnimController name="show_log_delayed" autoPlay="0" _events="event_delay_home_btn"><ActionChain><ActionGroup><aEfxVisible visible="0" duration="0"/><EfxMove duration="0" from_x="260" from_y="0" to_x="360" to_y="0"/><EfxAlpha path="root/*/log" duration="0" from="0" to="0"/></ActionGroup><ActionGroup><EfxAlpha duration="0.5" from="0" to="1"/><EfxMove duration="1" from_x="360" from_y="0" to_x="260" to_y="0" modifier="sinexpand"/></ActionGroup></ActionChain></AnimController><AnimController autoPlay="0" events="event_anim_log"><ActionChain><ActionGroup><EfxScaleXY duration="0.1" mode="t" to_x="1.2" to_y="1.2"/><EfxRotate from="0" to="10" duration="0.1"/><aEfxHaptic mode="single" taptic="5"/></ActionGroup><ActionGroup><EfxScaleXY duration="0.1" mode="t" to_x="1.1" to_y="1.1"/><EfxRotate from="10" to="0" duration="0.1"/></ActionGroup><Ac