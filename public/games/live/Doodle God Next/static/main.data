<Layout xml="/status_bar/show_hide_status_bar.xml">

    <!--PaneController name="status_bar" x="0" y="0" events="e_sb_change_pane"-->

        <!--Widget name="main1"-->

            <Widget name="ads_info" x="0" y="56" xml="/interface/ads_info.xml"/>

            <PaneController name="status_bar2" x="0" y="0" events="e_change_sub_pane">
                <Widget name="main2">
                    <Widget x="0" y="14" xml="/interface/ui_enable_disable_animation.xml">
                        <StatusBarElementsReactionResult name="puz_elements_ctrl" x="44" y="0" alias="MAIN_MENU_BAR_ELEMENTS" main="1" mode="total">

                            <aAnimController autoPlay="1">
                                    <ActionGroup>
                                        <EfxMove duration="0" to_x="44" to_y="0" mode="t"/>
                                </ActionGroup>
                            </aAnimController>

                            <Image name="light_counter" x="60" y="13" width="22" height="22" image="/interface/light_counter.png" color="A0FFFFFF">
                            
                                <AnimController autoPlay="1">
                                    <ActionChain>
                                        <EfxAlpha from="0" to="0" duration="0"/>
                                    </ActionChain>
                                </AnimController>

                                <AnimController autoPlay="0" events="event_flash_counter_elements">
                                    <ActionChain>
                                        <ActionChain>
                                            <ActionGroup>
                                                <EfxAlpha from="0" to="0.6" duration="0.2"/>
                                                <EfxScaleXY duration="0.2" from_x="1" from_y="1" to_x="8.0" to_y="1.0"/>
                                            </ActionGroup>
                                            
                                            <EfxAlpha from="0.4" to="0" duration="0.3"/>
                                            
                                            <EfxScaleXY duration="0" from_x="8" from_y="1" to_x="1.0" to_y="1.0"/>
                                        </ActionChain>
                                    </ActionChain>
                                </AnimController>
                            </Image>


                            <Text name="elements" x="-9" y="3" width="150" height="14" font="baloo_bold_small" text="GROUPS_ELEMENTS_TITLE" align="C" color="73FFFFFF"/>

                            <CounterLabel name="e_counter" x="20" y="20"  numbers="5" imgs_path="/interface/counter_numbers" color="FFFFFFFF" clip="1" scale="0.48"/>
                            
                            <Text name="slash" x="55" y="17" width="20" height="14" font="baloo_bold_small" text="/" align="C" color="73FFFFFF"/>
                            
                            <CounterLabel name="e_available" x="71" y="20"  numbers="3" imgs_path="/interface/counter_numbers" color="FFFFFFFF" clip="1" scale="0.48"/>
                                    

                            <Widget name="elements_counter_point" x="40" y="-10"/>

                            <AnimController autoPlay="0" events="event_counter_elements_scale_anim">
                                <ActionChain>
                                    <ActionChain>
                                        <EfxScaleXY duration="0.1" from_x="1" from_y="1" to_x="0.9" to_y="0.9" />
                                        <EfxScaleXY duration="0.2" from_x="0.9" from_y="0.9" to_x="1.2" to_y="1.2"/>
                                        <EfxScaleXY duration="0.1" from_x="1.2" from_y="1.2" to_x="1.0" to_y="1.0"/>
                                    </ActionChain>
                                </ActionChain>
                            </AnimController>
                            <AnimController autoPlay="0" events="scale_elements_counter">
                                   <ActionChain>
                                       <ActionChain>
                                           <EfxScaleXY duration="0.1" from_x="1" from_y="1" to_x="0.9" to_y="0.9" />
                                           <EfxScaleXY duration="0.2" from_x="0.9" from_y="0.9" to_x="1.2" to_y="1.2"/>
                                           <EfxScaleXY duration="0.1" from_x="1.2" from_y="1.2" to_x="1.0" to_y="1.0"/>
                                           <EfxSendEvent event="event_flash_counter_elements" param=""/>
                                       </ActionChain>
                                   </ActionChain>
                            </AnimController>
                                                
                            
                        </StatusBarElementsReactionResult>
                    </Widget>
                    <StatusBarGoal x="140" y="14" width="120" height="32" icon_height="28" msg_alias="%s">
                        <Text name="text" x="0" y="3" width="120" height="14" font="baloo_bold_small" text="" align="E" _scale="0.9" autoFit="1" color="FFFFFFFF"/>
                        <Image name="icon" x="130" y="3" width="28" height="28"/>
                    </StatusBarGoal>

                    <StatusBarProgress x="140" y="14" alias="STATUS_BAR_PROGRESS_VALUE">
                        <Text name="value" x="0" y="17" width="120" height="14" font="baloo_bold_small" text="" _scale="0.9" align="E"/>
                    </StatusBarProgress>
                    <!--
                    <StatusBarGoal x="48" y="0" width="210" height="32" icon_height="28" msg_alias="PUZ_TARGET_MSG_PORTRAIT">
                        <Text name="text" x="-5" y="16" width="190" height="30" font="baloo_bold_medium" text="" align="Ð¡" scale="0.9" color="FFFFFFFF"/>
                        <Image name="icon" x="180" y="16" width="28" height="28"/>
                    </StatusBarGoal>

                    <StatusBarProgress x="265" y="16" alias="STATUS_BAR_PROGRESS_PUZZLE_PORTRAIT">
                        <Text name="value" x="0" y="0" width="70" height="30" font="baloo_bold_medium" text="" scale="0.9" align="W"/>
                    </StatusBarProgress>
                    -->

                    <ToolbarButton name="b" x="0" y="0" image="/newbank/back_btn.png">
                        <Click cmd="layout" param="back" />
                       
                    </ToolbarButton>


                    <!--ToolbarButton name="alphabet" x="260" y="0" image="/toolbar/zoom.png">
                        <Click cmd="layout" param="AlphabetView"/>

                        <AnimController autoPlay="0" events="e_hide_alphabet_btn">
                            <ActionGroup>
                                <EfxVisible delay="0" visible="0"/>
                            </ActionGroup>
                        </AnimController>
                    </ToolbarButton-->
                </Widget>
                <!-- HINT 2 TITLE -->
                <Widget name="hint2">
                    <Text x="0" y="0" width="320" height="32" font="font" text="HINT2_TITLE" align="C"/>

                    <AnimController autoPlay="1">
                        <ActionGroup>
                            <EfxSendEvent delay="0" event="e_puzzle_hint2_controller">{"enable":true}</EfxSendEvent>

                            <ActionRepeat count="-1">
                                <ActionChain>
                                    <EfxColor duration="0.5" from="FFFFFFFF" to="FFFF0000" modifier="sindiminish" />
                                    <EfxColor duration="0.5" from="FFFF0000" to="FFFFFFFF" modifier="sindiminish" />
                                </ActionChain>
                            </ActionRepeat>
                        </ActionGroup>
                    </AnimController>
                </Widget>
            </PaneController>

            <AnimController autoPlay="0" events="use_hint_2">
                <ActionGroup>
                    <EfxSendEvent event="e_change_sub_pane" param="hint2"/>
                </ActionGroup>
            </AnimController>

            <AnimController autoPlay="1">
                <ActionGroup>
                    <EfxSendEvent event="e_change_sub_pane" param="main2"/>
                </ActionGroup>
            </AnimController>
        </Widget>

        <!-- MANA -->
        <!--ManaWidget name="mana" x="-20" y="0" xml="/shop/sb_mana.xml"/-->

    </PaneController>

    <aAnimController autoPlay="1">
        <ActionGroup>
            <EfxSendEvent event="e_sb_change_pane" param="main1"/>
        </ActionGroup>
    </aAnimController>

    <aEventSwitchWidget event="e_puzzle_hint2_controller">
        <Case id="e_user_interaction" group="hide"/>

        <Group id="hide">
            <Event id="e_change_sub_pane">{"page":"main",}</Event>
            <Event id="e_puzzle_hint2_controller">{"enable":false,}</Event>
        </Group>
    </aEventSwitchWidget>
</Layout>
