    <!-- Teaser 1 -->
    <String name="TEASER1_SKIP">(Ã¼berspringen)</String>

    <String name="TEASER1_CAPTION">Einleitung:</String>
    <String name="TEASER1_1">Am Anfang war \nnur Doodle God.</String>
    <String name="TEASER1_2">Doodle God erschuf\ndie vier Grundelemente ...</String>
    <String name="TEASER1_3">Aus Erde erschuf Doodle God\ndie Planeten ...</String>
    <String name="TEASER1_4">Aus Wasser wurden GewÃ¤sser \nund Ozeane erschaffen ...</String>
    <String name="TEASER1_5">Aus Feuer wurden\nVulkane hervorgebracht ... und anderes Zeug ...</String>
    <String name="TEASER1_6">Aus Luft ... Du weiÃŸt schon ... Halt Luft ...</String>
    <String name="TEASER1_7">Die Welt war aber noch \nunendlich groÃŸ und menschenleer ...</String>
    <String name="TEASER1_8">... Und dann hatte Doodle God \neine zÃ¼ndende Idee!</String>
    <String name="TEASER1_9">'Was wÃ¤re, wenn ich die Grundelemente\nmiteinander verbinde, um neue zu erschaffen?'</String>
    <String name="TEASER1_10">Und Doodle God begann,\nneue Elemente zu kreieren ...</String>
    <String name="TEASER1_11">'Wow! Es gibt so viele Kombinationen\nund so viel zu erschaffen!'</String>

    <!-- Teaser 2 -->

    <String name="TEASER2_CAPTION">Episode zwei</String>
    <String name="TEASER2_1">Doodle God trat zurÃ¼ck,\num sich alle Kreationen anzusehen ...</String>
    <String name="TEASER2_2">Und er bemerkte die\nunendliche Leere rundum ...</String>
    <String name="TEASER2_3">Auch Leere kann ein gutes \nElement fÃ¼r Kreationen sein ...</String>
    <String name="TEASER2_4">Und Doodle God \nverkÃ¼ndete des Weiteren ...</String>
    <String name="TEASER2_5">'Lass es mich jetzt meiner Liste hinzufÃ¼gen'</String>

    <!-- Teaser 3 -->
    <String name="TEASER3_CAPTION">Episode drei</String>
    <String name="TEASER3_1">In der heutigen Welt gibt es\nsolch eine Auswahlvielfalt.</String>
    <String name="TEASER3_2">Aber fÃ¼rwahr! Einige Dinge \nkÃ¶nnen ganz einfach nicht koexistieren!</String>
    <String name="TEASER3_3">Daher ... Was wÃ¤re, wenn \ndie Welten getrennt wÃ¤ren,</String>
    <String name="TEASER3_4">und ihre Bewohner ihren eigenen\nWeg beschreiten kÃ¶nnten?</String>
    <String name="TEASER3_5">'Um sicher zu sein' -\nmeinte Doodle God -</String>
    <String name="TEASER3_6">'Sie werden Weisheit,\nWissen und ... Ã¤h ... das ganze Zeugs brauchen.'</String>

    <!-- Teaser 4 -->
    <String name="TEASER4_CAPTION">Episode vier</String>
    <String name="TEASER4_1">Doodle God dachte, es wÃ¤re eine\nÃ¤uÃŸerst brillante Idee ...</String>
    <String name="TEASER4_2">... den Menschen die\nMacht zur Kreation zu verleihen.</String>
    <String name="TEASER4_3">Sodann kÃ¶nnen sie die Welt \nnach ihren WÃ¼nschen gestalten.</String>
    <String name="TEASER4_4">'Ups, sie haben soeben ein\nSkelett im Schrank gefunden.'</String>
    <String name="TEASER4_5">Gut, mal sehen, ob sie\nso tapfer sind, das zu meistern!</String>

    <!-- Teaser Quest Santa -->
    <String name="TEASER_Q1_CAPTION">Lauf, Weihnachtsmann, lauf:</String>
    <String name="TEASER_Q1_1">Der Weihnachtsmann bemerkte soeben, dass zu\nwenig Geschenke hergestellt wurden.</String>
    <String name="TEASER_Q1_2">Und es bleibt nicht\nmehr viel Zeit.</String>
    <String name="TEASER_Q1_3">Meine GÃ¼te!</String>
    <String name="TEASER_Q1_4">Wir sollten uns beeilen \nund mehr Geschenke herstellen!</String>

    <!-- Teaser Quest Princess -->
    <String name="TEASER_Q2_CAPTION">Rette die Prinzessin:</String>
    <String name="TEASER_Q2_1">Eine mÃ¤chtige TragÃ¶die ereignete \nsich in unserem KÃ¶nigreich!</String>
    <String name="TEASER_Q2_2">GlÃ¼cklicherweise haben wir eine\nMenge Helden, die helfen kÃ¶nnen!</String>


